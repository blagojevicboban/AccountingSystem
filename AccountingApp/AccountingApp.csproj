<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AccountingData\AccountingData.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Kopira CHANGELOG.md iz korena repozitorijuma (jedini izvor istine) u izlazni
         direktorijum, tako da ga ChangelogWindow može učitati u runtime-u. -->
    <Content Include="..\CHANGELOG.md" Link="CHANGELOG.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.0-rc4.5" />
    <PackageReference Include="QuestPDF" Version="2024.12.3" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    
    <!-- Citamo verziju direktno iz version.txt kako bi bila ispravna i pri buildu iz Visual Studio-a -->
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\..\version.txt').Trim())</Version>

    <Authors>Blagojević Boban</Authors>
    <Company>Blagojević Boban</Company>
    <Product>AccountingApp</Product>
    <Copyright>Copyright © Blagojević Boban 2026</Copyright>
  </PropertyGroup>

</Project>
