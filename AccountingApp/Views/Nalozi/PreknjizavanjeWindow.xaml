<Window x:Class="AccountingApp.Views.Nalozi.PreknjizavanjeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Preknjižavanje konta" Height="340" Width="460" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="🔄 Preknjižavanje konta" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
            <TextBlock Text="Zamenjuje broj konta na svim stavkama naloga knjiženja (analogno DOS proceduri prekm)." FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Staro konto (za zamenu) *" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtStaroKonto" Height="34" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,14" MaxLength="20"/>

            <TextBlock Text="Novo konto *" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtNovoKonto" Height="34" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,14" MaxLength="20"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Odustani" Width="100" Height="36" Margin="0,0,10,0" Background="#E2E8F0" Foreground="#334155" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" Click="BtnOdustani_Click"/>
            <Button Content="🔄 Preknjiži" Width="120" Height="36" Style="{StaticResource ActionButtonStyle}" Background="#4F46E5" Click="BtnIzvrsi_Click"/>
        </StackPanel>
    </Grid>
</Window>
