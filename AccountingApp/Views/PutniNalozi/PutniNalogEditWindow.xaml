<Window x:Class="AccountingApp.Views.PutniNalozi.PutniNalogEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🚗 Službeno putovanje &amp; Putni nalog — Unos i Obračun" 
        Height="640" Width="860"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC">

    <Window.Resources>
        <ResourceDictionary Source="/Resources/Styles.xaml"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- General Info -->
            <RowDefinition Height="Auto"/> <!-- Dnevnice Info -->
            <RowDefinition Height="*"/>    <!-- Expenses DataGrid -->
            <RowDefinition Height="Auto"/> <!-- Footer Actions -->
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" CornerRadius="8" Padding="16,10" Margin="0,0,0,12">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#0D9488" Offset="0"/>
                    <GradientStop Color="#059669" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="🚗" FontSize="28" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtNaslov" Text="Putni nalog i Obračun službenog putovanja" FontSize="16" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Obračun dnevnica, goriva, smeštaja i pratećih troškova za službena putovanja u zemlji i inostranstvu." FontSize="11" Foreground="#CCFBF1"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- GENERAL INFO -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="14" Margin="0,0,0,10" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="180"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Vrsta putovanja:" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                <ComboBox Grid.Row="1" Grid.Column="0" x:Name="CmbVrsta" Height="32" Margin="0,2,10,0">
                    <ComboBoxItem Content="Zemlja (5330)" IsSelected="True"/>
                    <ComboBoxItem Content="Inostranstvo (5340)"/>
                </ComboBox>

                <TextBlock Grid.Row="0" Grid.Column="1" Text="Zaposleni (Ime i prezime):" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtZaposleni" FontSize="13" Padding="8,4" Margin="0,2,10,0"/>

                <TextBlock Grid.Row="0" Grid.Column="2" Text="Relacija putovanja:" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                <TextBox Grid.Row="1" Grid.Column="2" x:Name="TxtRelacija" FontSize="13" Padding="8,4" Margin="0,2,10,0"/>

                <TextBlock Grid.Row="0" Grid.Column="3" Text="Prevozno sredstvo:" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                <ComboBox Grid.Row="1" Grid.Column="3" x:Name="CmbPrevoz" Height="32">
                    <ComboBoxItem Content="Službeno vozilo" IsSelected="True"/>
                    <ComboBoxItem Content="Privatno vozilo"/>
                    <ComboBoxItem Content="Autobus / Voz"/>
                    <ComboBoxItem Content="Avion"/>
                </ComboBox>
            </Grid>
        </Border>

        <!-- DNEVNICE CALCULATION INFO -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="14" Margin="0,0,0,10" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="130"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="Polazak (Datum i vreme):" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                    <DatePicker x:Name="DpPolazak" Height="30" SelectedDateChanged="DpPolazak_SelectedDateChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                    <TextBlock Text="Povratak (Datum i vreme):" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                    <DatePicker x:Name="DpPovratak" Height="30" SelectedDateChanged="DpPovratak_SelectedDateChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                    <TextBlock Text="Ukupno sati:" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtSati" FontSize="13" Padding="6,4" IsReadOnly="True" TextAlignment="Center" Background="#F1F5F9"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="0,0,8,0">
                    <TextBlock Text="Broj dnevnica:" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtBrojDnevnica" FontSize="13" Padding="6,4" IsReadOnly="True" TextAlignment="Center" FontWeight="Bold" Background="#F1F5F9"/>
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock Text="Dnevnica (RSD):" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtIznosDnevnice" FontSize="13" Padding="6,4" Text="3000" TextAlignment="Right" TextChanged="TxtIznosDnevnice_TextChanged"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- EXPENSES DATAGRID -->
        <Border Grid.Row="3" Background="White" CornerRadius="8" Padding="12" BorderBrush="#E2E8F0" BorderThickness="1">
            <DockPanel>
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8" VerticalAlignment="Center">
                    <TextBlock Text="Vrsta troška:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0"/>
                    <ComboBox x:Name="CmbVrstaTroska" Width="140" Height="30" Margin="0,0,10,0">
                        <ComboBoxItem Content="Gorivo" IsSelected="True"/>
                        <ComboBoxItem Content="Smeštaj"/>
                        <ComboBoxItem Content="Prevoz"/>
                        <ComboBoxItem Content="Putarina"/>
                        <ComboBoxItem Content="Taksiji"/>
                        <ComboBoxItem Content="Ostalo"/>
                    </ComboBox>

                    <TextBlock Text="Broj računa:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0"/>
                    <TextBox x:Name="TxtBrojRacunaTrosak" Width="110" Height="30" Margin="0,0,10,0"/>

                    <TextBlock Text="Iznos (RSD):" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0"/>
                    <TextBox x:Name="TxtIznosTrosak" Width="90" Height="30" TextAlignment="Right" Margin="0,0,10,0"/>

                    <Button Content="➕ Dodaj račun troška" Style="{StaticResource PrimaryButton}" Height="30" Padding="12,0" Click="BtnDodajTrosak_Click"/>
                </WrapPanel>

                <DataGrid x:Name="DgStavkeTroskova" AutoGenerateColumns="False" CanUserAddRows="False"
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="White" RowHeight="30" FontSize="11">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="R.br." Binding="{Binding RedniBroj}" Width="50" ElementStyle="{StaticResource CenterAlign}"/>
                        <DataGridTextColumn Header="Vrsta troška" Binding="{Binding VrstaTroska}" Width="120" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="Broj računa" Binding="{Binding BrojRacuna}" Width="120"/>
                        <DataGridTextColumn Header="Opis" Binding="{Binding Opis}" Width="*"/>
                        <DataGridTextColumn Header="Iznos (RSD)" Binding="{Binding Iznos, StringFormat=\{0:N2\}}" Width="120" ElementStyle="{StaticResource RightAlign}" FontWeight="Bold"/>
                        <DataGridTemplateColumn Header="Ukloni" Width="65">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="❌" Click="BtnUkloniTrosak_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- FOOTER ACTIONS -->
        <DockPanel Grid.Row="4" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                <TextBlock Text="Ukupno za isplatu:" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="TxtUkupnoZaIsplatu" Text="0,00 RSD" FontSize="18" FontWeight="Bold" Foreground="#0D9488" VerticalAlignment="Center" Margin="0,0,20,0"/>

                <Button Content="Odustani" Style="{StaticResource SecondaryButton}" Height="38" Padding="14,0" Margin="0,0,8,0" Click="BtnOdustani_Click"/>
                <Button Content="💾 Sačuvaj putni nalog" Style="{StaticResource PrimaryButton}" Height="38" Padding="18,0" Click="BtnSacuvaj_Click"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Isplaćena akontacija:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold"/>
                <TextBox x:Name="TxtAkontacija" Width="110" Height="32" TextAlignment="Right" TextChanged="TxtAkontacija_TextChanged"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
