<Window x:Class="AccountingApp.Views.Trgovina.NivelacijaEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🏷️ Nivelacija cena" Height="600" Width="850"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}" KeyDown="Window_KeyDown">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Naslov -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="🏷️ Nivelacija prodajnih cena" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
            <TextBlock Text="Promena prodajnih cena artikala u magacinu i obračun razlike u ceni." FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Zaglavlje -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Br. nivelacije:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtBrojNivelacije" Height="32" VerticalContentAlignment="Center" Padding="6,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Datum:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <DatePicker x:Name="DpDatum" Height="32" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Magacin:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbMagacin" Height="32" DisplayMemberPath="NazivMagacina" SelectedValuePath="MagacinId"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tabela stavki -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="📋 Stavke nivelacije" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button x:Name="BtnDodajStavku" Content="➕ Dodaj stavku" Style="{StaticResource ActionButtonStyle}" Click="BtnDodajStavku_Click" Margin="0,0,8,0"/>
                    <Button x:Name="BtnObrisiStavku" Content="🗑 Obriši stavku" Style="{StaticResource ActionButtonStyle}" Background="#DC2626" Click="BtnObrisiStavku_Click"/>
                </StackPanel>

                <DataGrid x:Name="DgStavke" AutoGenerateColumns="False" CanUserAddRows="False" GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column" Background="Transparent" BorderThickness="0" CellEditEnding="DgStavke_CellEditEnding">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="R.br" Binding="{Binding RedniBroj}" IsReadOnly="True" Width="45"/>
                        <DataGridComboBoxColumn x:Name="ColArtikli" Header="Artikal / Roba" SelectedValueBinding="{Binding ArtikalId}" Width="*"/>
                        <DataGridTextColumn Header="Količina zaliha" Binding="{Binding KolicinaZaliha, StringFormat=\{0:N2\}}" Width="110" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                        <DataGridTextColumn Header="Stara cena" Binding="{Binding StaraCena, StringFormat=\{0:N2\}}" Width="110" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                        <DataGridTextColumn Header="Nova cena" Binding="{Binding NovaCena, StringFormat=\{0:N2\}}" Width="110" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                        <DataGridTextColumn Header="Razlika/jed." Binding="{Binding RazlikaPoJedinici, StringFormat=\{0:N2\}}" IsReadOnly="True" Width="110" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                        <DataGridTextColumn Header="Uk. razlika" Binding="{Binding UkupnaRazlika, StringFormat=\{0:N2\}}" IsReadOnly="True" Width="130" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- Rekapitulacija -->
        <Border Grid.Row="3" Background="White" CornerRadius="8" Padding="16" Margin="0,16,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <DockPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="UKUPNA RAZLIKA NIVELACIJE:" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <TextBlock x:Name="TxtUkupnaRazlika" Text="0,00 RSD" FontSize="16" FontWeight="Bold" Foreground="#10B981" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Dugmad -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="BtnOtkazi" Content="Otkaži (Esc)" IsCancel="True" Style="{StaticResource ActionButtonStyle}" Background="#64748B" Click="BtnOtkazi_Click" Margin="0,0,10,0"/>
            <Button x:Name="BtnSačuvaj" Content="💾 Sačuvaj nivelaciju" Style="{StaticResource ActionButtonStyle}" Background="#10B981" Click="BtnSačuvaj_Click"/>
        </StackPanel>
    </Grid>
</Window>
