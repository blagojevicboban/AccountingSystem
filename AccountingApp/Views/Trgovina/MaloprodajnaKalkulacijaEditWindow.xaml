<Window x:Class="AccountingApp.Views.Trgovina.MaloprodajnaKalkulacijaEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nova kalkulacija (maloprodaja)" Height="820" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="📋 Osnovni podaci" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,12"/>
                        <UniformGrid Columns="3">
                            <StackPanel Margin="0,0,12,12">
                                <TextBlock Text="Broj kalkulacije" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBox x:Name="TxtBrojKalkulacije" Height="32" VerticalContentAlignment="Center" Padding="6,0"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,12">
                                <TextBlock Text="Datum" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                <DatePicker x:Name="DpDatum" Height="32"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Šifra prodavnice" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBox x:Name="TxtSifraProdavnice" Height="32" VerticalContentAlignment="Center" Padding="6,0"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Magacin (daje)" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                <ComboBox x:Name="CmbMagacinDaje" Height="32" DisplayMemberPath="NazivMagacina"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Magacin (prima)" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                <ComboBox x:Name="CmbMagacinPrima" Height="32" DisplayMemberPath="NazivMagacina"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Šifra dobavljača" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBox x:Name="TxtSifraDobavljaca" Height="32" VerticalContentAlignment="Center" Padding="6,0"/>
                            </StackPanel>
                            <StackPanel Margin="0,12,12,0">
                                <TextBlock Text="Broj otpremnice" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBox x:Name="TxtBrojOtpremnice" Height="32" VerticalContentAlignment="Center" Padding="6,0"/>
                            </StackPanel>
                            <StackPanel Margin="0,12,12,0">
                                <TextBlock Text="Datum otpremnice" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                <DatePicker x:Name="DpDatumOtpremnice" Height="32"/>
                            </StackPanel>
                            <StackPanel Margin="0,12,0,0"/>
                            <StackPanel Margin="0,12,12,0">
                                <TextBlock Text="Broj računa" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBox x:Name="TxtBrojRacuna" Height="32" VerticalContentAlignment="Center" Padding="6,0"/>
                            </StackPanel>
                            <StackPanel Margin="0,12,12,0">
                                <TextBlock Text="Datum računa" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                <DatePicker x:Name="DpDatumRacuna" Height="32"/>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="💰 Nabavka i zavisni troškovi" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,12"/>
                        <UniformGrid Columns="3">
                            <StackPanel Margin="0,0,12,12">
                                <TextBlock Text="Nabavna vrednost" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBox x:Name="TxtNabavnaVrednost" Height="32" VerticalContentAlignment="Center" Padding="6,0" TextChanged="Input_Changed"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,12">
                                <TextBlock Text="Transportni troškovi" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBox x:Name="TxtTransportniTroskovi" Height="32" VerticalContentAlignment="Center" Padding="6,0" TextChanged="Input_Changed"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Troškovi uskladištenja" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBox x:Name="TxtTroskoviUskladistenja" Height="32" VerticalContentAlignment="Center" Padding="6,0" TextChanged="Input_Changed"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Utovar / istovar" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBox x:Name="TxtUtovarIstovar" Height="32" VerticalContentAlignment="Center" Padding="6,0" TextChanged="Input_Changed"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Transportno osiguranje" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBox x:Name="TxtTransportnoOsiguranje" Height="32" VerticalContentAlignment="Center" Padding="6,0" TextChanged="Input_Changed"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Ostali troškovi" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBox x:Name="TxtOstaliTroskovi" Height="32" VerticalContentAlignment="Center" Padding="6,0" TextChanged="Input_Changed"/>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="📦 Stavke kalkulacije (artikli)" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <Button x:Name="BtnDodajStavku" Content="➕ Dodaj stavku" Style="{StaticResource ActionButtonStyle}" Click="BtnDodajStavku_Click" Margin="0,0,8,0"/>
                            <Button x:Name="BtnObrisiStavku" Content="🗑 Obriši stavku" Style="{StaticResource ActionButtonStyle}" Background="#DC2626" Click="BtnObrisiStavku_Click"/>
                        </StackPanel>
                        <TextBlock Text="Ako se unesu stavke, prodajna cena po jedinici mere se izračunava po artiklu (troškovi se raspodeljuju srazmerno) i knjiži se kao izlaz (razduženje) iz magacina koji daje robu pri knjiženju kalkulacije. Bez stavki, kalkulacija ostaje na nivou dokumenta kao i do sada." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10"/>
                        <DataGrid x:Name="DgStavke" Height="200" AutoGenerateColumns="False" CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="Transparent" BorderThickness="0" CellEditEnding="DgStavke_CellEditEnding">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="R.br." Binding="{Binding RedniBroj}" Width="45" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Šifra artikla" Binding="{Binding SifraArtikla, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                                <DataGridTextColumn Header="Količina" Binding="{Binding Kolicina, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" Width="90" ElementStyle="{StaticResource NumericColumnElementStyle}" EditingElementStyle="{StaticResource NumericColumnEditingStyle}"/>
                                <DataGridTextColumn Header="Nabavna cena" Binding="{Binding NabavnaCena, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" Width="100" ElementStyle="{StaticResource NumericColumnElementStyle}" EditingElementStyle="{StaticResource NumericColumnEditingStyle}"/>
                                <DataGridTextColumn Header="Troškovi" Binding="{Binding Troskovi, StringFormat=N2}" Width="90" IsReadOnly="True" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                                <DataGridTextColumn Header="Nabavna vred." Binding="{Binding NabavnaVrednost, StringFormat=N2}" Width="100" IsReadOnly="True" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                                <DataGridTextColumn Header="Prodajna cena/jm" Binding="{Binding ProdajnaCena, StringFormat=N2}" Width="120" IsReadOnly="True" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="📈 Marža, PDV i rabat" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,12"/>
                        <UniformGrid Columns="3">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Razlika u ceni — marža (%)" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBox x:Name="TxtMarzaProcenat" Height="32" VerticalContentAlignment="Center" Padding="6,0" TextChanged="Input_Changed"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Poreska stopa — PDV (%)" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBox x:Name="TxtPoreskaStopaProcenat" Height="32" VerticalContentAlignment="Center" Padding="6,0" TextChanged="Input_Changed"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Rabat dobavljača (%)" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBox x:Name="TxtRabatPri" Height="32" VerticalContentAlignment="Center" Padding="6,0" TextChanged="Input_Changed"/>
                            </StackPanel>
                        </UniformGrid>
                        <TextBlock Text="Napomena: Rabat je informativni obračun popusta dobavljača na nabavnu vrednost — ne umanjuje prodajnu vrednost (isto kao u prethodnoj sistemu)." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="#F1F5F9" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="🧮 Obračun" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Svega troškovi: " FontWeight="SemiBold"/>
                                <TextBlock x:Name="TxtSvegaTroskovi" Text="0,00"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Svega nabavno: " FontWeight="SemiBold"/>
                                <TextBlock x:Name="TxtSvegaNabavno" Text="0,00"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Razlika (marža): " FontWeight="SemiBold"/>
                                <TextBlock x:Name="TxtRazlika" Text="0,00"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Porez (PDV): " FontWeight="SemiBold"/>
                                <TextBlock x:Name="TxtPorez" Text="0,00"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Rabat (informativno): " FontWeight="SemiBold"/>
                                <TextBlock x:Name="TxtRabatIznos" Text="0,00"/>
                            </StackPanel>
                        </Grid>
                        <Border Background="#DBEAFE" CornerRadius="6" Padding="12,10" Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="PRODAJNA VREDNOST: " FontWeight="Bold" FontSize="15"/>
                                <TextBlock x:Name="TxtProdajnaVrednost" Text="0,00" FontWeight="Bold" FontSize="15" Foreground="#1D4ED8"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="BtnOtkazi" Content="Otkaži" Style="{StaticResource ActionButtonStyle}" Background="#64748B" Click="BtnOtkazi_Click" Margin="0,0,10,0"/>
            <Button x:Name="BtnSnimi" Content="💾 Snimi kalkulaciju" Style="{StaticResource ActionButtonStyle}" Background="#10B981" Click="BtnSnimi_Click"/>
        </StackPanel>
    </Grid>
</Window>
