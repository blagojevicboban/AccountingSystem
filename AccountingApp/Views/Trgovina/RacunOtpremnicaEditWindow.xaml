<Window x:Class="AccountingApp.Views.Trgovina.RacunOtpremnicaEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🧾 Račun - Otpremnica (Faktura)" Height="650" Width="950"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}" KeyDown="Window_KeyDown">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Naslov -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="🧾 Račun - Otpremnica (Faktura)" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
            <TextBlock Text="Prodaja robe, obračun rabata i PDV-a sa automatskim generisanjem naloga knjiženja." FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Zaglavlje -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Grid x:Name="GridHeader">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,12,8">
                    <TextBlock Text="Br. računa:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtBrojRacuna" Height="32" VerticalContentAlignment="Center" Padding="6,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Grid.Row="0" Margin="0,0,12,8">
                    <TextBlock Text="Datum računa:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <DatePicker x:Name="DpDatum" Height="32" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Grid.Row="0" Margin="0,0,12,8">
                    <TextBlock Text="Rok dospelosti:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <DatePicker x:Name="DpRok" Height="32" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Grid.Row="0" Margin="0,0,12,8">
                    <TextBlock Text="Kupac / Partner:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbPartner" Height="32" DisplayMemberPath="Naziv" SelectedValuePath="PartnerId"/>
                </StackPanel>

                <StackPanel Grid.Column="4" Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="Magacin:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbMagacin" Height="32" DisplayMemberPath="NazivMagacina" SelectedValuePath="MagacinId"/>
                </StackPanel>

                <StackPanel Grid.Column="0" Grid.ColumnSpan="5" Grid.Row="1" Margin="0,4,0,0">
                    <TextBlock Text="Napomena:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtNapomena" Height="30" VerticalContentAlignment="Center" Padding="6,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tabela stavki -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="📋 Stavke fakture" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button x:Name="BtnDodajStavku" Content="➕ Dodaj stavku" Style="{StaticResource ActionButtonStyle}" Click="BtnDodajStavku_Click" Margin="0,0,8,0"/>
                    <Button x:Name="BtnObrisiStavku" Content="🗑 Obriši stavku" Style="{StaticResource ActionButtonStyle}" Background="#DC2626" Click="BtnObrisiStavku_Click"/>
                </StackPanel>

                <DataGrid x:Name="DgStavke" AutoGenerateColumns="False" CanUserAddRows="False" GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column" Background="Transparent" BorderThickness="0" CellEditEnding="DgStavke_CellEditEnding">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="R.br" Binding="{Binding RedniBroj}" IsReadOnly="True" Width="45"/>
                        <DataGridComboBoxColumn x:Name="ColArtikli" Header="Artikal / Roba" SelectedValueBinding="{Binding ArtikalId}" Width="*"/>
                        <DataGridTextColumn Header="Količina" Binding="{Binding Kolicina, StringFormat=\{0:N2\}}" Width="100" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                        <DataGridTextColumn Header="Cena" Binding="{Binding ProdajnaCena, StringFormat=\{0:N2\}}" Width="110" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                        <DataGridTextColumn Header="Rabat %" Binding="{Binding RabatProcenat, StringFormat=\{0:N0\}}" Width="80" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                        <DataGridTextColumn Header="Osnovica" Binding="{Binding Osnovica, StringFormat=\{0:N2\}}" IsReadOnly="True" Width="120" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                        <DataGridTextColumn Header="PDV %" Binding="{Binding StopaPdv, StringFormat=\{0:N0\}}" Width="75" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                        <DataGridTextColumn Header="Ukupno" Binding="{Binding Ukupno, StringFormat=\{0:N2\}}" IsReadOnly="True" Width="130" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- Rekapitualcija -->
        <Border Grid.Row="3" Background="White" CornerRadius="8" Padding="16" Margin="0,16,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <DockPanel x:Name="PnlRekapitulacija">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="Osnovica:" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock x:Name="TxtUkupnoOsnovica" Text="0,00 RSD" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="PDV (20%):" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock x:Name="TxtUkupnoPdv" Text="0,00 RSD" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="ZA UPLATU:" FontSize="12" FontWeight="Bold" Foreground="#2563EB"/>
                        <TextBlock x:Name="TxtUkupnoZaUplatu" Text="0,00 RSD" FontSize="16" FontWeight="Bold" Foreground="#2563EB"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Dugmad -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="BtnOtkazi" Content="Otkaži (Esc)" IsCancel="True" Style="{StaticResource ActionButtonStyle}" Background="#64748B" Click="BtnOtkazi_Click" Margin="0,0,10,0"/>
            <Button x:Name="BtnSačuvaj" Content="💾 Sačuvaj fakturu" Style="{StaticResource ActionButtonStyle}" Background="#10B981" Click="BtnSačuvaj_Click"/>
        </StackPanel>
    </Grid>
</Window>
