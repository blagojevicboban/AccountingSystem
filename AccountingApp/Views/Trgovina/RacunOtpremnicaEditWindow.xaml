<Window x:Class="AccountingApp.Views.Trgovina.RacunOtpremnicaEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Račun - Otpremnica" Height="660" Width="920"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource BackgroundBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TxtNaslov" Text="📜 Račun - Otpremnica" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Grid.Row="0" Margin="0,0,0,16"/>

        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <CheckBox x:Name="ChkPredracun" Content="📝 Predračun (ne knjiži se dok se ne pretvori u račun)" FontWeight="SemiBold"
                          Grid.ColumnSpan="3" VerticalAlignment="Center" Checked="ChkPredracun_CheckedChanged" Unchecked="ChkPredracun_CheckedChanged"/>
                <TextBlock x:Name="TxtRokVazenjaLabel" Text="Rok važenja predračuna" Grid.Column="3" VerticalAlignment="Center" FontWeight="SemiBold" Visibility="Collapsed"/>
                <DatePicker x:Name="DpRokVazenja" Grid.Column="4" Height="34" VerticalContentAlignment="Center" Visibility="Collapsed"/>

                <TextBlock Text="Broj računa *" Grid.Row="2" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBox x:Name="TxtBrojRacuna" Grid.Row="2" Grid.Column="1" Height="34" VerticalContentAlignment="Center" Padding="8,0"/>

                <TextBlock Text="Broj otpremnice" Grid.Row="2" Grid.Column="3" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBox x:Name="TxtBrojOtpremnice" Grid.Row="2" Grid.Column="4" Height="34" VerticalContentAlignment="Center" Padding="8,0"/>

                <TextBlock Text="Datum računa *" Grid.Row="4" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <DatePicker x:Name="DpDatum" Grid.Row="4" Grid.Column="1" Height="34" VerticalContentAlignment="Center"/>

                <TextBlock Text="Rok plaćanja (dana)" Grid.Row="4" Grid.Column="3" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBox x:Name="TxtRokPlacanja" Grid.Row="4" Grid.Column="4" Height="34" VerticalContentAlignment="Center" Padding="8,0" Text="15"/>

                <TextBlock Text="Kupac / Konto *" Grid.Row="6" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBox x:Name="TxtKontoKupca" Grid.Row="6" Grid.Column="1" Height="34" VerticalContentAlignment="Center" Padding="8,0"/>

                <TextBlock Text="Način plaćanja" Grid.Row="6" Grid.Column="3" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
                <ComboBox x:Name="CmbNacinPlacanja" Grid.Row="6" Grid.Column="4" Height="34" VerticalContentAlignment="Center" IsEditable="True">
                    <ComboBoxItem Content="Virman (račun)" IsSelected="True"/>
                    <ComboBoxItem Content="Gotovina"/>
                    <ComboBoxItem Content="Kartica"/>
                </ComboBox>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="📋 Stavke fakture i robe" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <Button x:Name="BtnDodajStavku" Content="➕ Dodaj stavku" Style="{StaticResource ActionButtonStyle}" Click="BtnDodajStavku_Click"/>
                </StackPanel>

                <DataGrid x:Name="DgStavke" AutoGenerateColumns="False" CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="Transparent" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="R.br." Binding="{Binding RedniBroj}" Width="45" IsReadOnly="True"/>
                        <DataGridComboBoxColumn x:Name="ColArtikal" Header="Artikal *" Width="2*"/>
                        <DataGridTextColumn Header="Količina *" Binding="{Binding Kolicina, StringFormat=\{0:N2\}}" Width="90"/>
                        <DataGridTextColumn Header="Prod. cena *" Binding="{Binding Cena, StringFormat=\{0:N2\}}" Width="100"/>
                        <DataGridTextColumn Header="Rabat %" Binding="{Binding RabatProcenat, StringFormat=\{0:N2\}}" Width="70"/>
                        <DataGridTextColumn Header="PDV %" Binding="{Binding PdvProcenat, StringFormat=\{0:N0\}}" Width="65"/>
                        <DataGridTextColumn Header="Bez PDV" Binding="{Binding IznosBezPdv, StringFormat=\{0:N2\}}" Width="105"/>
                        <DataGridTextColumn Header="Ukupno" Binding="{Binding UkupanIznos, StringFormat=\{0:N2\}}" Width="110"/>
                        <DataGridTemplateColumn Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="🗑️" Width="30" Height="26" Background="#EF4444" Foreground="White" Click="BtnUkloniStavku_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="BtnOtkazi" Content="Odustani" Width="100" Height="36" Margin="0,0,10,0" Click="BtnOtkazi_Click"/>
            <Button x:Name="BtnSacuvaj" Content="💾 Sačuvaj račun" Width="130" Height="36" Style="{StaticResource ActionButtonStyle}" Click="BtnSacuvaj_Click"/>
        </StackPanel>
    </Grid>
</Window>
