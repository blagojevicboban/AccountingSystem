<Window x:Class="AccountingApp.Views.Trgovina.NarudzbenicaEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🛒 Narudžbenica Dobavljaču — Unos i izmena" 
        Height="620" Width="840"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC">

    <Window.Resources>
        <ResourceDictionary Source="/Resources/Styles.xaml"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Main Info -->
            <RowDefinition Height="*"/>    <!-- Items DataGrid -->
            <RowDefinition Height="Auto"/> <!-- Footer Totals & Actions -->
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" CornerRadius="8" Padding="16,10" Margin="0,0,0,12">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#059669" Offset="0"/>
                    <GradientStop Color="#10B981" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="🛒" FontSize="28" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtNaslov" Text="Narudžbenica dobavljaču (Purchase Order)" FontSize="16" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Evidencija naručene robe i ugovorenih nabavnih cena sa dobavljačima." FontSize="11" Foreground="#A7F3D0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN INFO -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="14" Margin="0,0,0,10" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Dobavljač / Partner:" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                <ComboBox Grid.Row="1" Grid.Column="0" x:Name="CmbDobavljaci" DisplayMemberPath="Naziv" SelectedValuePath="PartnerId" Height="32" Margin="0,2,10,0"/>

                <TextBlock Grid.Row="0" Grid.Column="1" Text="Datum narudžb.:" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                <DatePicker Grid.Row="1" Grid.Column="1" x:Name="DpDatum" Height="32" Margin="0,2,10,0"/>

                <TextBlock Grid.Row="0" Grid.Column="2" Text="Rok isporuke:" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                <DatePicker Grid.Row="1" Grid.Column="2" x:Name="DpRokIsporuke" Height="32" Margin="0,2,0,0"/>
            </Grid>
        </Border>

        <!-- ITEMS DATAGRID -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="10" BorderBrush="#E2E8F0" BorderThickness="1">
            <DockPanel>
                <!-- Add item toolbar -->
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8" VerticalAlignment="Center">
                    <TextBlock Text="Artikal:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0"/>
                    <ComboBox x:Name="CmbArtikli" DisplayMemberPath="Naziv" SelectedValuePath="SifraArtikla" Width="260" Height="30" Margin="0,0,10,0" SelectionChanged="CmbArtikli_SelectionChanged"/>
                    
                    <TextBlock Text="Količ. naručeno:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0"/>
                    <TextBox x:Name="TxtKolicina" Width="70" Height="30" Text="1" TextAlignment="Right" Margin="0,0,10,0"/>

                    <TextBlock Text="Nabavna cena:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0"/>
                    <TextBox x:Name="TxtCena" Width="90" Height="30" TextAlignment="Right" Margin="0,0,10,0"/>

                    <Button Content="➕ Dodaj stavku" Style="{StaticResource PrimaryButton}" Height="30" Padding="12,0" Click="BtnDodajStavku_Click"/>
                </WrapPanel>

                <DataGrid x:Name="DgStavke" AutoGenerateColumns="False" CanUserAddRows="False"
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                          Background="White" RowHeight="32" FontSize="12">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="R.br." Binding="{Binding RedniBroj}" Width="50" ElementStyle="{StaticResource CenterAlign}"/>
                        <DataGridTextColumn Header="Šifra" Binding="{Binding SifraArtikla}" Width="90"/>
                        <DataGridTextColumn Header="Naziv artikla" Binding="{Binding NazivArtikla}" Width="*"/>
                        <DataGridTextColumn Header="J.M." Binding="{Binding JedinicaMere}" Width="50" ElementStyle="{StaticResource CenterAlign}"/>
                        <DataGridTextColumn Header="Naručeno" Binding="{Binding KolicinaNarucena, StringFormat=\{0:N2\}}" Width="85" ElementStyle="{StaticResource RightAlign}" FontWeight="Bold"/>
                        <DataGridTextColumn Header="Nabavna cena" Binding="{Binding Cena, StringFormat=\{0:N2\}}" Width="95" ElementStyle="{StaticResource RightAlign}"/>
                        <DataGridTextColumn Header="Neto" Binding="{Binding IznosNeto, StringFormat=\{0:N2\}}" Width="100" ElementStyle="{StaticResource RightAlign}"/>
                        <DataGridTextColumn Header="PDV (20%)" Binding="{Binding IznosPdv, StringFormat=\{0:N2\}}" Width="90" ElementStyle="{StaticResource RightAlign}"/>
                        <DataGridTextColumn Header="Ukupno Bruto" Binding="{Binding IznosBruto, StringFormat=\{0:N2\}}" Width="110" ElementStyle="{StaticResource RightAlign}" FontWeight="Bold"/>
                        <DataGridTemplateColumn Header="Ukloni" Width="65">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="❌" Click="BtnUkloniStavku_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- FOOTER -->
        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                <TextBlock Text="Ukupno Naručeno Bruto:" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="TxtUkupnoBruto" Text="0,00 RSD" FontSize="18" FontWeight="Bold" Foreground="#059669" VerticalAlignment="Center" Margin="0,0,20,0"/>

                <Button Content="Odustani" Style="{StaticResource SecondaryButton}" Height="38" Padding="14,0" Margin="0,0,8,0" Click="BtnOdustani_Click"/>
                <Button Content="💾 Sačuvaj narudžbenicu" Style="{StaticResource PrimaryButton}" Height="38" Padding="18,0" Click="BtnSacuvaj_Click"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Napomena:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold"/>
                <TextBox x:Name="TxtNapomena" Width="300" Height="32"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
