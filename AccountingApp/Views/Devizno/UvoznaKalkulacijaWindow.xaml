<Window x:Class="AccountingApp.Views.Devizno.UvoznaKalkulacijaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🛃 Uvozna Kalkulacija (Ino-Faktura, Carina &amp; Zavisni Troškovi)" Height="650" Width="1000"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="🛃 Izrada Uvozne Kalkulacije" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
            <TextBlock Text="Unos ino-fakture u devizama, proračun carine, špedicije, prevoza i raspodela na uvozne nabavne cene." FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Zaglavlje uvoza -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Row 0 -->
                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="Broj kalkulacije:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtBrojKalkulacije" Height="32" VerticalContentAlignment="Center" Padding="6,0" Text="UV-2026/001"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2">
                    <TextBlock Text="Ino Dobavljač:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbInoPartner" Height="32" DisplayMemberPath="Naziv" SelectedValuePath="PartnerId"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="4">
                    <TextBlock Text="Broj Ino-fakture:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtInoBrojFakture" Height="32" VerticalContentAlignment="Center" Padding="6,0" Text="INV-99823"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="6">
                    <TextBlock Text="Valuta i Kurs:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="TxtValuta" Width="50" Height="32" VerticalContentAlignment="Center" Padding="4,0" Text="EUR"/>
                        <TextBox x:Name="TxtKurs" Width="90" Height="32" VerticalContentAlignment="Center" Padding="4,0" Text="117.2000" Margin="6,0,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Row 1: Zavisni troškovi -->
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,10,0,0">
                    <TextBlock Text="Špedicija (RSD):" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtSpedicija" Height="32" VerticalContentAlignment="Center" Padding="6,0" Text="15000.00" TextChanged="Troskovi_TextChanged"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,10,0,0">
                    <TextBlock Text="Prevoz (RSD):" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtPrevoz" Height="32" VerticalContentAlignment="Center" Padding="6,0" Text="25000.00" TextChanged="Troskovi_TextChanged"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="4" Margin="0,10,0,0">
                    <TextBlock Text="Ostali troškovi (RSD):" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtOstaliTroskovi" Height="32" VerticalContentAlignment="Center" Padding="6,0" Text="5000.00" TextChanged="Troskovi_TextChanged"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="6" Margin="0,10,0,0">
                    <TextBlock Text="Ciljni magacin:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbMagacin" Height="32" DisplayMemberPath="Naziv" SelectedValuePath="MagacinId"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tabela uvoznih artikala -->
        <DataGrid Grid.Row="2" x:Name="DgStavke" AutoGenerateColumns="False" CanUserAddRows="False" Background="{StaticResource SurfaceBrush}" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Artikal ID" Binding="{Binding ArtikalId}" Width="80"/>
                <DataGridTextColumn Header="Količina" Binding="{Binding Kolicina, StringFormat={}{0:N2}}" Width="90"/>
                <DataGridTextColumn Header="Ino cena (EUR)" Binding="{Binding InoCenaDevize, StringFormat={}{0:N2}}" Width="110"/>
                <DataGridTextColumn Header="Ino devize" Binding="{Binding InoIznosDevize, StringFormat={}{0:N2}}" Width="110" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                <DataGridTextColumn Header="Ino RSD" Binding="{Binding InoIznosRsd, StringFormat={}{0:N2}}" Width="120" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                <DataGridTextColumn Header="Carina %" Binding="{Binding CarinaProcenat, StringFormat={}{0:N1}%}" Width="80"/>
                <DataGridTextColumn Header="Carina RSD" Binding="{Binding CarinaIznosRsd, StringFormat={}{0:N2}}" Width="110" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                <DataGridTextColumn Header="Zavisni RSD" Binding="{Binding RasporedjeniZavisniTroskoviRsd, StringFormat={}{0:N2}}" Width="110" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                <DataGridTextColumn Header="Ukupna Nabavna (RSD)" Binding="{Binding UkupnaNabavnaVrednostRsd, StringFormat={}{0:N2}}" Width="150" ElementStyle="{StaticResource NumericColumnElementStyle}" FontWeight="Bold"/>
                <DataGridTextColumn Header="Cena/Jed RSD" Binding="{Binding NabavnaCenaPoJediniciRsd, StringFormat={}{0:N2}}" Width="120" ElementStyle="{StaticResource NumericColumnElementStyle}" FontWeight="Bold"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Footer -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <TextBlock x:Name="TxtStatus" Text="Ukupna uvozna nabavna vrednost..." VerticalAlignment="Center" FontWeight="Bold" Foreground="#0284C7"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="➕ Dodaj uvozni artikal" Style="{StaticResource ActionButtonStyle}" Background="#0284C7" Height="34" Padding="14,0" Margin="0,0,10,0" Click="BtnDodajStavku_Click"/>
                <Button Content="💾 Sačuvaj i Knjiži Uvoz" Style="{StaticResource ActionButtonStyle}" Background="#059669" Height="34" Padding="16,0" Margin="0,0,10,0" Click="BtnSacuvaj_Click"/>
                <Button Content="Zatvori" Width="100" Height="34" Click="BtnZatvori_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
