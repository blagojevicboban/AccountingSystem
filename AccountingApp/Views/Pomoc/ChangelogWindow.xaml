<Window x:Class="AccountingApp.Views.Pomoc.ChangelogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="📋 Istorija izmena (Changelog) — AccountingSystem"
        Height="620" Width="780"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" CornerRadius="8" Padding="20,16">
            <DockPanel LastChildFill="True">
                <TextBlock Text="📋 Istorija izmena i novina (Changelog)"
                           FontSize="18" FontWeight="Bold" Foreground="White"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtAppVersion" Text="v1.0.0"
                           FontSize="13" FontWeight="SemiBold" Foreground="#BFDBFE"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <WebBrowser x:Name="WbChangelog"/>
        </Border>

        <DockPanel Grid.Row="4" LastChildFill="False">
            <TextBlock Text="AccountingSystem © 2026 — Autor: Blagojević Boban" Foreground="{StaticResource TextMutedBrush}"
                       FontSize="11" VerticalAlignment="Center" DockPanel.Dock="Left"/>
            <Button Content="Zatvori" Style="{StaticResource ActionButtonStyle}"
                    Width="110" Height="36" Click="BtnZatvori_Click" DockPanel.Dock="Right"/>
        </DockPanel>
    </Grid>
</Window>
