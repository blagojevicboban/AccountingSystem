<Window x:Class="AccountingApp.Views.Izvestaji.ZakljucniListPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:AccountingData.Services;assembly=AccountingData"
        Title="Zaključni list — pregled" Height="700" Width="1100"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="16,12" Margin="0,0,0,16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <DockPanel>
                <Button x:Name="BtnExportExcelZakljucniList" DockPanel.Dock="Right" Content="📊 Excel" Style="{StaticResource ActionButtonStyle}" Background="#059669" VerticalAlignment="Center" Click="BtnExportExcelZakljucniList_Click"/>
                <StackPanel>
                    <TextBlock x:Name="TxtNaslov" Text="ZAKLJUČNI LIST" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock x:Name="TxtPodnaslov" Text="" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <DockPanel>
                <Border DockPanel.Dock="Bottom" Margin="0,12,0,0" Padding="16,10" CornerRadius="8" Background="#F1F5F9">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="Ukupno duguje: " FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtUkupnoDuguje" Text="0,00" FontWeight="Bold" Margin="0,0,20,0"/>
                        <TextBlock Text="Ukupno potražuje: " FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtUkupnoPotrazuje" Text="0,00" FontWeight="Bold" Margin="0,0,20,0"/>
                        <TextBlock Text="Saldo duguje: " FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtUkupnoSaldoDuguje" Text="0,00" FontWeight="Bold" Foreground="#059669" Margin="0,0,20,0"/>
                        <TextBlock Text="Saldo potražuje: " FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtUkupnoSaldoPotrazuje" Text="0,00" FontWeight="Bold" Foreground="#059669"/>
                    </StackPanel>
                </Border>

                <DataGrid x:Name="DgZakljucniList" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="Transparent" BorderThickness="0">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Tip}" Value="{x:Static svc:BrutoBilansRedTip.SintetikaTotal}">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Background" Value="#F8FAFC"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Tip}" Value="{x:Static svc:BrutoBilansRedTip.KlasaTotal}">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Background" Value="#E2E8F0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Konto" Binding="{Binding BrojKonta}" Width="70"/>
                        <DataGridTextColumn Header="Naziv konta" Binding="{Binding NazivKonta}" Width="*"/>
                        <DataGridTextColumn Header="Duguje" Binding="{Binding Duguje, StringFormat=\{0:N2\}}" Width="135" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                        <DataGridTextColumn Header="Potražuje" Binding="{Binding Potrazuje, StringFormat=\{0:N2\}}" Width="135" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                        <DataGridTextColumn Header="Saldo duguje" Binding="{Binding SaldoDuguje, StringFormat=\{0:N2\}}" Width="135" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                        <DataGridTextColumn Header="Saldo potražuje" Binding="{Binding SaldoPotrazuje, StringFormat=\{0:N2\}}" Width="135" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</Window>
