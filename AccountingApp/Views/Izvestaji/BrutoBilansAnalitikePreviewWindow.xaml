<Window x:Class="AccountingApp.Views.Izvestaji.BrutoBilansAnalitikePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bruto bilans analitike — pregled" Height="700" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="16,12" Margin="0,0,0,16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <DockPanel>
                <Button x:Name="BtnExportExcelAnalitike" DockPanel.Dock="Right" Content="X" FontWeight="Bold" FontSize="20" Style="{StaticResource ActionButtonStyle}" Background="#059669" Width="36" Padding="0" ToolTip="Izvoz u Excel" VerticalAlignment="Center" Click="BtnExportExcelAnalitike_Click"/>
                <StackPanel>
                    <TextBlock x:Name="TxtNaslov" Text="BRUTO BILANS ANALITIKE (PARTNERI)" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock x:Name="TxtPodnaslov" Text="" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <DockPanel>
                <Border DockPanel.Dock="Bottom" Margin="0,12,0,0" Padding="16,10" CornerRadius="8" Background="#F1F5F9">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="Ukupno duguje: " FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtUkupnoDuguje" Text="0,00" FontWeight="Bold" Margin="0,0,20,0"/>
                        <TextBlock Text="Ukupno potražuje: " FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtUkupnoPotrazuje" Text="0,00" FontWeight="Bold" Margin="0,0,20,0"/>
                        <TextBlock Text="Saldo: " FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtUkupnoSaldo" Text="0,00" FontWeight="Bold" Foreground="#DB2777"/>
                    </StackPanel>
                </Border>

                <DataGrid x:Name="DgAnalitike" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="Transparent" BorderThickness="0" FontSize="12">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Šifra" Binding="{Binding SifraPartnera}" Width="90"/>
                        <DataGridTextColumn Header="Partner" Binding="{Binding NazivPartnera}" Width="*"/>
                        <DataGridTextColumn Header="Duguje" Binding="{Binding Duguje, StringFormat=\{0:N2\}}" Width="140" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                        <DataGridTextColumn Header="Potražuje" Binding="{Binding Potrazuje, StringFormat=\{0:N2\}}" Width="140" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                        <DataGridTextColumn Header="Saldo" Binding="{Binding Saldo, StringFormat=\{0:N2\}}" Width="140" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</Window>
