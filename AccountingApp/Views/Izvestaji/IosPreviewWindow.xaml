<Window x:Class="AccountingApp.Views.Izvestaji.IosPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Izvod otvorenih stavki (IOS) — pregled na ekranu" Height="780" Width="1400"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="16,12" Margin="0,0,0,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnStampajPrikazanuIos" Content="📄 Štampaj prikazanu (PDF)" Style="{StaticResource ActionButtonStyle}" Background="#2563EB" Margin="0,0,8,0" Click="BtnStampajPrikazanuIos_Click" IsEnabled="False"/>
                    <Button x:Name="BtnStampajIzabraneIos" Content="🖨️ Štampaj izabrane (PDF)" Style="{StaticResource ActionButtonStyle}" Background="#4F46E5" Margin="0,0,8,0" Click="BtnStampajIzabraneIos_Click" IsEnabled="False"/>
                    <Button x:Name="BtnExportPdfIos" Content="📥 Izvezi sve (PDF)" Style="{StaticResource ActionButtonStyle}" Background="#7C3AED" Margin="0,0,8,0" Click="BtnExportPdfIos_Click"/>
                    <Button x:Name="BtnExportExcelIos" Content="X" FontWeight="Bold" FontSize="20" Style="{StaticResource ActionButtonStyle}" Background="#059669" Width="36" Padding="0" ToolTip="Izvoz u Excel" Click="BtnExportExcelIos_Click"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="TxtNaslov" Text="IZVOD OTVORENIH STAVKI (IOS)" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock x:Name="TxtPodnaslov" Text="" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main content area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Partner list with CheckBoxes matching KarticeView -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="👥 Partneri i konta za IOS" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,8"/>
                    <TextBox x:Name="TxtPretraga" DockPanel.Dock="Top" Margin="0,0,0,8" Height="30" VerticalContentAlignment="Center" Padding="8,0" TextChanged="TxtPretraga_TextChanged" ToolTip="Pretraga po partneru ili kontu..."/>
                    
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <CheckBox x:Name="ChkSelectAll" Content="Označi sve" DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="11" Click="ChkSelectAll_Click"/>
                        <CheckBox x:Name="ChkSamoSaSaldom" Content="Samo neusaglašeni (nenulti) saldo" IsChecked="True" VerticalAlignment="Center" FontSize="11" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                    </DockPanel>

                    <!-- Summary bar at bottom of partner list -->
                    <Border DockPanel.Dock="Bottom" Margin="0,8,0,0" Padding="8,6" CornerRadius="6" Background="#F1F5F9">
                        <DockPanel>
                            <TextBlock x:Name="TxtUkupanSaldoSvi" DockPanel.Dock="Right" Text="Ukupno: 0,00 RSD" FontSize="11" FontWeight="Bold" Foreground="#7C3AED"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TxtBrojPartnera" Text="Partnera: 0" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,10,0"/>
                                <TextBlock x:Name="TxtBrojIzabranih" Text="Izabrano: 0" FontSize="11" FontWeight="Bold" Foreground="#4F46E5"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <DataGrid x:Name="LstPartneri" AutoGenerateColumns="False" SelectionMode="Single" SelectionUnit="FullRow" GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="Transparent" BorderThickness="0" SelectionChanged="LstPartneri_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="30">
                                <DataGridCheckBoxColumn.ElementStyle>
                                    <Style TargetType="CheckBox">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridCheckBoxColumn.ElementStyle>
                            </DataGridCheckBoxColumn>
                            <DataGridTextColumn Header="Konto" Binding="{Binding Konto}" Width="55" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Partner / Naziv" Binding="{Binding NazivPartnera}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Saldo" Binding="{Binding Saldo, StringFormat=\{0:N2\}}" Width="95" IsReadOnly="True" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Right Panel: Selected Partner's open items -->
            <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <DockPanel>
                    <!-- Partner header -->
                    <Border DockPanel.Dock="Top" Margin="0,0,0,12" Padding="12,8" CornerRadius="6" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                                <TextBlock Text="Saldo za usaglašavanje:" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock x:Name="TxtPartnerSaldo" Text="0,00 RSD" FontSize="16" FontWeight="Bold" Foreground="#7C3AED" HorizontalAlignment="Right"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock x:Name="TxtSelectedPartnerNaziv" Text="Izaberite partnera sa liste" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                                <TextBlock x:Name="TxtSelectedPartnerInfo" Text="" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Bottom Summary Bar for selected partner -->
                    <Border DockPanel.Dock="Bottom" Margin="0,12,0,0" Padding="12,8" CornerRadius="8" Background="#F1F5F9">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="UKUPNO ZA PARTNERA:" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal" Margin="0,2,16,2">
                                    <TextBlock Text="Duguje: " FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock x:Name="TxtUkupnoDuguje" Text="0,00" FontWeight="Bold" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2,16,2">
                                    <TextBlock Text="Potražuje: " FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock x:Name="TxtUkupnoPotrazuje" Text="0,00" FontWeight="Bold" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                    <TextBlock Text="Saldo: " FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock x:Name="TxtSaldoSum" Text="0,00" FontWeight="Bold" Foreground="#7C3AED" FontSize="11"/>
                                </StackPanel>
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <!-- Items DataGrid -->
                    <DataGrid x:Name="DgOtvoreneStavke" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="Transparent" BorderThickness="0" FontSize="12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Datum" Binding="{Binding Datum, StringFormat=\{0:dd.MM.yyyy\}}" Width="90"/>
                            <DataGridTextColumn Header="Nalog" Binding="{Binding BrojNaloga}" Width="75"/>
                            <DataGridTextColumn Header="Dokument" Binding="{Binding OpisPromene}" Width="110"/>
                            <DataGridTextColumn Header="Opis" Binding="{Binding Opis}" Width="*"/>
                            <DataGridTextColumn Header="Duguje" Binding="{Binding Duguje, StringFormat=\{0:N2\}}" Width="115" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                            <DataGridTextColumn Header="Potražuje" Binding="{Binding Potrazuje, StringFormat=\{0:N2\}}" Width="115" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                            <DataGridTextColumn Header="Saldo" Binding="{Binding Saldo, StringFormat=\{0:N2\}}" Width="120" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
