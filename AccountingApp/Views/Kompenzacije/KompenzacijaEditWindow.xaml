<Window x:Class="AccountingApp.Views.Kompenzacije.KompenzacijaEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🤝 Kompenzacija / Poravnanje — Unos i izmena" 
        Height="620" Width="860"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Partner Selection -->
            <RowDefinition Height="*"/>    <!-- Open Invoices Selection -->
            <RowDefinition Height="Auto"/> <!-- Footer Totals & Actions -->
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" CornerRadius="8" Padding="16,10" Margin="0,0,0,12">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#4F46E5" Offset="0"/>
                    <GradientStop Color="#7C3AED" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="🤝" FontSize="28" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtNaslov" Text="Izjava o kompenzaciji / poravnanju" FontSize="16" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Prebijanje obostranih dugovanja i potraživanja sa partnerom ili trećim licima." FontSize="11" Foreground="#C7D2FE"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- PARTNER SELECTION -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="14" Margin="0,0,0,10" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Vrsta poravnanja:" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbVrsta" Height="32">
                        <ComboBoxItem Content="Dvojna kompenzacija" IsSelected="True"/>
                        <ComboBoxItem Content="Ugovor o asignaciji"/>
                        <ComboBoxItem Content="Ugovor o cesiji"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="Partner / Ugovorna strana:" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbPartneri" DisplayMemberPath="Naziv" SelectedValuePath="PartnerId" Height="32" SelectionChanged="CmbPartneri_SelectionChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Datum kompenzacije:" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                    <DatePicker x:Name="DpDatum" Height="32"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- OPEN INVOICES SELECTION -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/> <!-- Potraživanja (Konto 2040) -->
                <ColumnDefinition Width="*"/> <!-- Obaveze (Konto 4350) -->
            </Grid.ColumnDefinitions>

            <!-- Kupci (Konto 2040) -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="12" Margin="0,0,6,0" BorderBrush="#E2E8F0" BorderThickness="1">
                <DockPanel>
                    <TextBlock Text="📤 Potraživanja od kupca (Konto 2040)" FontSize="13" FontWeight="Bold" Foreground="#1E293B" DockPanel.Dock="Top" Margin="0,0,0,8"/>
                    <DataGrid x:Name="DgKupciStavke" AutoGenerateColumns="False" CanUserAddRows="False"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="White" RowHeight="30" FontSize="11">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Prebij" Binding="{Binding IsSelected}" Width="50"/>
                            <DataGridTextColumn Header="Dokument" Binding="{Binding BrojDokumenta}" Width="90"/>
                            <DataGridTextColumn Header="Datum" Binding="{Binding Datum, StringFormat=\{0:dd.MM.yyyy\}}" Width="80"/>
                            <DataGridTextColumn Header="Preostalo" Binding="{Binding Preostalo, StringFormat=\{0:N2\}}" Width="95" ElementStyle="{StaticResource RightAlign}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Dobavljači (Konto 4350) -->
            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="12" Margin="6,0,0,0" BorderBrush="#E2E8F0" BorderThickness="1">
                <DockPanel>
                    <TextBlock Text="📥 Obaveze prema dobavljaču (Konto 4350)" FontSize="13" FontWeight="Bold" Foreground="#1E293B" DockPanel.Dock="Top" Margin="0,0,0,8"/>
                    <DataGrid x:Name="DgDobavljaciStavke" AutoGenerateColumns="False" CanUserAddRows="False"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="White" RowHeight="30" FontSize="11">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Prebij" Binding="{Binding IsSelected}" Width="50"/>
                            <DataGridTextColumn Header="Dokument" Binding="{Binding BrojDokumenta}" Width="90"/>
                            <DataGridTextColumn Header="Datum" Binding="{Binding Datum, StringFormat=\{0:dd.MM.yyyy\}}" Width="80"/>
                            <DataGridTextColumn Header="Preostalo" Binding="{Binding Preostalo, StringFormat=\{0:N2\}}" Width="95" ElementStyle="{StaticResource RightAlign}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- FOOTER -->
        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                <TextBlock Text="Iznos Kompenzacije:" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="TxtUkupanIznos" Text="0,00 RSD" FontSize="18" FontWeight="Bold" Foreground="#7C3AED" VerticalAlignment="Center" Margin="0,0,20,0"/>

                <Button Content="Odustani" Style="{StaticResource SecondaryButton}" Height="38" Padding="14,0" Margin="0,0,8,0" Click="BtnOdustani_Click"/>
                <Button Content="💾 Sačuvaj predlog" Style="{StaticResource PrimaryButton}" Height="38" Padding="18,0" Click="BtnSacuvaj_Click"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Napomena:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold"/>
                <TextBox x:Name="TxtNapomena" Width="300" Height="32"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
