<Window x:Class="AccountingApp.Views.Dms.DmsOcrPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🔍 AI / OCR Čitač skeniranih računa — ERPi Finansije" 
        Height="640" Width="840"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Content & Fields -->
            <RowDefinition Height="Auto"/> <!-- Footer Actions -->
        </Grid.RowDefinitions>

        <!-- ── HEADER ──────────────────────────────────────────────── -->
        <Border Grid.Row="0" CornerRadius="8" Padding="16,12" Margin="0,0,0,12">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#0284C7" Offset="0"/>
                    <GradientStop Color="#2563EB" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="🔍" FontSize="32" VerticalAlignment="Center" Margin="0,0,14,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="AI / OCR Prepoznavanje i Ekstrakcija Ulaznih Računa" 
                               FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Prepoznati PIB, broj računa i iznosi sa skeniranog ulaznog računa za brzu pripremu naloga knjiženja." 
                               FontSize="12" Foreground="#BAE6FD" Margin="0,2,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── CONTENT ────────────────────────────────────────────── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/> <!-- Extracted Form Fields -->
                <ColumnDefinition Width="0.8*"/> <!-- Raw Text Logs -->
            </Grid.ColumnDefinitions>

            <!-- Extracted Form -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="16" Margin="0,0,8,0"
                    BorderBrush="#E2E8F0" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Status Badge -->
                        <Border x:Name="BadgeStatus" Background="#E0F2FE" CornerRadius="6" Padding="12,8" Margin="0,0,0,14">
                            <TextBlock x:Name="TxtStatus" Text="Status: Analiziranje..." FontSize="12" FontWeight="SemiBold" Foreground="#0369A1" TextWrapping="Wrap"/>
                        </Border>

                        <!-- PIB Dobavljača -->
                        <TextBlock Text="PIB Dobavljača:" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtPib" FontSize="13" Padding="8,5" Margin="0,0,0,10" TextChanged="TxtPib_TextChanged"/>

                        <!-- Naziv Dobavljača / Partner ComboBox -->
                        <TextBlock Text="Dobavljač (Partner u bazi):" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbPartneri" DisplayMemberPath="Naziv" SelectedValuePath="PartnerId" FontSize="13" Padding="8,5" Margin="0,0,0,10"/>

                        <!-- Broj Računa -->
                        <TextBlock Text="Broj ulaznog računa:" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtBrojRacuna" FontSize="13" Padding="8,5" Margin="0,0,0,10"/>

                        <!-- Datumi -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Datum računa:" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                <DatePicker x:Name="DpDatumRacuna" Padding="4"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="Valuta dospelosti:" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                <DatePicker x:Name="DpValuta" Padding="4"/>
                            </StackPanel>
                        </Grid>

                        <!-- Iznosi -->
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="Neto (Osnovica):" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtOsnovica" FontSize="13" Padding="8,5" TextAlignment="Right"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                <TextBlock Text="PDV (20%):" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtPdv" FontSize="13" Padding="8,5" TextAlignment="Right"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                <TextBlock Text="Bruto (Ukupno):" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtUkupno" FontSize="13" FontWeight="Bold" Padding="8,5" TextAlignment="Right" Foreground="#16A34A"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Raw Text OCR Preview -->
            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="14" Margin="8,0,0,0"
                    BorderBrush="#E2E8F0" BorderThickness="1">
                <DockPanel>
                    <TextBlock Text="📄 Izvučeni teksto-sadržaj računa:" FontSize="12" FontWeight="Bold" Foreground="#475569" DockPanel.Dock="Top" Margin="0,0,0,8"/>
                    <TextBox x:Name="TxtRawText" IsReadOnly="True" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                             TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="11" Foreground="#334155" Background="#F8FAFC" Padding="8"/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ── FOOTER ACTIONS ─────────────────────────────────────── -->
        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <Button Content="Zatvori (Esc)" Style="{StaticResource SecondaryButton}" DockPanel.Dock="Left"
                    Height="40" Padding="16,0" Click="BtnZatvori_Click"/>

            <Button x:Name="BtnPripremiNalog" Content="🚀  Pripremi nalog knjiženja (Konta 5010 / 2700 / 4350)" 
                    Style="{StaticResource PrimaryButton}" DockPanel.Dock="Right"
                    Height="40" Padding="20,0" Click="BtnPripremiNalog_Click"/>
        </DockPanel>
    </Grid>
</Window>
