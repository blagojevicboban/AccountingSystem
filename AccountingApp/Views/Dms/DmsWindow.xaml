<Window x:Class="AccountingApp.Views.Dms.DmsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="📎 DMS — Upravljanje prilozima i skeniranim dokumentima" Height="550" Width="780"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock x:Name="TxtNaslovDms" Text="📎 Priloženi Dokumenti (DMS)" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
            <TextBlock Text="Upravljanje skeniranim ulaznim računima, ugovorima i sporednom dokumentacijom." FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Action bar -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <DockPanel>
                <Button Content="➕ Priloži dokument (PDF / Slika)" Style="{StaticResource ActionButtonStyle}" Height="36" Padding="16,0" Click="BtnDodajPrilog_Click"/>
                <TextBlock x:Name="TxtBrojDokumenata" Text="Broj dokumenata: 0" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold"/>
            </DockPanel>
        </Border>

        <!-- DataGrid dokumenata -->
        <DataGrid Grid.Row="2" x:Name="DgPrilozi" AutoGenerateColumns="False" IsReadOnly="True" Background="{StaticResource SurfaceBrush}" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Naziv fajla" Binding="{Binding NazivFajla}" Width="*" FontWeight="SemiBold"/>
                <DataGridTextColumn Header="Tip dokumenta" Binding="{Binding TipDokumenta}" Width="140"/>
                <DataGridTextColumn Header="Veličina" Binding="{Binding VelicinaBytes}" Width="100"/>
                <DataGridTextColumn Header="Datum" Binding="{Binding DatumPriloga, StringFormat=\{0:dd.MM.yyyy HH:mm\}}" Width="140"/>
                <DataGridTextColumn Header="Priložio" Binding="{Binding Korisnik}" Width="90"/>
                <DataGridTemplateColumn Header="Akcije" Width="160">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="👁️ Otvori" Click="BtnOtvoriFajl_Click" Padding="8,2" Margin="0,0,4,0" Background="#0284C7" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                                <Button Content="🗑️ Briši" Click="BtnObrisiFajl_Click" Padding="8,2" Background="#EF4444" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Footer -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <TextBlock x:Name="TxtStatus" Text="Spremno za rad sa dokumentima." VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
            <Button Content="Zatvori" Width="100" Height="34" HorizontalAlignment="Right" Click="BtnZatvori_Click"/>
        </Grid>
    </Grid>
</Window>
