<Window x:Class="AccountingApp.Views.Magacin.TrebovanjeEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Novo trebovanje" Height="600" Width="800"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="Broj naloga" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBox x:Name="TxtBrojNaloga" Width="100" Height="32" VerticalContentAlignment="Center" Padding="6,0"/>
                </StackPanel>
                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="Datum" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                    <DatePicker x:Name="DpDatum" Width="130" Height="32"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Magacin (izdaje)" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                    <ComboBox x:Name="CmbMagacin" Width="220" Height="32" DisplayMemberPath="NazivMagacina"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="📦 Stavke trebovanja" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button x:Name="BtnDodajStavku" Content="➕ Dodaj stavku" Style="{StaticResource ActionButtonStyle}" Click="BtnDodajStavku_Click" Margin="0,0,8,0"/>
                    <Button x:Name="BtnObrisiStavku" Content="🗑 Obriši stavku" Style="{StaticResource ActionButtonStyle}" Background="#DC2626" Click="BtnObrisiStavku_Click"/>
                </StackPanel>

                <TextBlock DockPanel.Dock="Top" Text="Napomena: trebovanje se knjiži po trenutnoj prosečnoj ceni artikla — cena se ne unosi ručno." FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10" TextWrapping="Wrap"/>

                <DataGrid x:Name="DgStavke" AutoGenerateColumns="False" CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="Transparent" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="R.br." Binding="{Binding RedniBroj}" Width="50" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Šifra artikla" Binding="{Binding SifraArtikla, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                        <DataGridTextColumn Header="Količina" Binding="{Binding Kolicina, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" Width="120"/>
                        <DataGridTextColumn Header="Konto troška" Binding="{Binding KontoTroska, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="BtnOtkazi" Content="Otkaži" Style="{StaticResource ActionButtonStyle}" Background="#64748B" Click="BtnOtkazi_Click" Margin="0,0,10,0"/>
            <Button x:Name="BtnSnimi" Content="💾 Snimi trebovanje" Style="{StaticResource ActionButtonStyle}" Background="#10B981" Click="BtnSnimi_Click"/>
        </StackPanel>
    </Grid>
</Window>
