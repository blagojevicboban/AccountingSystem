<Window x:Class="AccountingApp.Views.Magacin.ProveraKarticaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Provera materijalnih kartica" Height="500" Width="800"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="⚠️ Negativna stanja i negativne cene u materijalnim karticama" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Grid.Row="0" Margin="0,0,0,12"/>

        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <DataGrid x:Name="DgProvera" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="Transparent" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Magacin" Binding="{Binding SifraMagacina}" Width="80"/>
                    <DataGridTextColumn Header="Artikal" Binding="{Binding SifraArtikla}" Width="90"/>
                    <DataGridTextColumn Header="R.br." Binding="{Binding RedniBroj}" Width="60"/>
                    <DataGridTextColumn Header="Datum" Binding="{Binding DatumPromene, StringFormat=\{0:dd.MM.yyyy\}}" Width="100"/>
                    <DataGridTextColumn Header="Opis promene" Binding="{Binding OpisPromene}" Width="*"/>
                    <DataGridTextColumn Header="Cena" Binding="{Binding Cena, StringFormat=\{0:N2\}}" Width="100" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                    <DataGridTextColumn Header="Stanje" Binding="{Binding Stanje, StringFormat=\{0:N2\}}" Width="100" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="BtnStampaj" Content="🖨️ Štampaj PDF" Width="130" Height="36" Style="{StaticResource ActionButtonStyle}" Margin="0,0,10,0" Click="BtnStampaj_Click"/>
            <Button x:Name="BtnZatvori" Content="Zatvori" Width="100" Height="36" Click="BtnZatvori_Click"/>
        </StackPanel>
    </Grid>
</Window>
