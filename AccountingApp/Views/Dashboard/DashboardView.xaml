<UserControl x:Class="AccountingApp.Views.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             mc:Ignorable="d"
             d:DesignHeight="950" d:DesignWidth="1100">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Quick Actions -->
                <RowDefinition Height="Auto"/> <!-- Financial KPIs (IOS & Liquidity) -->
                <RowDefinition Height="Auto"/> <!-- Top Partners (Kupci & Dobavljaci) -->
                <RowDefinition Height="Auto"/> <!-- LiveCharts -->
                <RowDefinition Height="Auto"/> <!-- Recent Nalozi & Firma info -->
            </Grid.RowDefinitions>

            <!-- ⚡ BRZE AKCIJE (QUICK ACTION BAR) -->
            <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="16,14" Margin="0,0,0,20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                        <TextBlock Text="⚡" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="BRZE AKCIJE:" FontSize="13" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center"/>
                    </StackPanel>

                    <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button x:Name="BtnOpenIos" Content="📄 Pregled Otvorenih Stavki (IOS)" Style="{StaticResource ActionButtonStyle}" Height="36" Padding="14,0" Margin="0,0,10,6" Click="BtnOpenIos_Click"/>
                        <Button x:Name="BtnOpenBrutoBilans" Content="📊 Bruto Bilans &amp; Izveštaji" Style="{StaticResource ActionButtonStyle}" Height="36" Padding="14,0" Margin="0,0,10,6" Background="#475569" Click="BtnOpenBrutoBilans_Click"/>
                        <Button x:Name="BtnNewNalog" Content="📖 Glavna Knjiga &amp; Nalozi" Style="{StaticResource ActionButtonStyle}" Height="36" Padding="14,0" Margin="0,0,10,6" Background="#0D9488" Click="BtnNewNalog_Click"/>
                        <Button x:Name="BtnDosImport" Content="📥 Uvoz DOS Podataka" Style="{StaticResource ActionButtonStyle}" Height="36" Padding="14,0" Margin="0,0,0,6" Background="#7C3AED" Click="BtnDosImport_Click"/>
                    </WrapPanel>
                </Grid>
            </Border>

            <!-- 💳 RED 1: FINANSIJSKA LIKVIDNOST I OTVORENE STAVKE (IOS KPIs) -->
            <StackPanel Grid.Row="1" Margin="0,0,0,20">
                <TextBlock Text="FINANSIJSKA LIKVIDNOST I OTVORENE STAVKE (IOS)" FontSize="12" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,10"/>
                <UniformGrid Columns="3">
                    <!-- Potraživanja od Kupaca -->
                    <Border Background="White" CornerRadius="12" Padding="18,16" Margin="0,0,8,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="POTRAŽIVANJA OD KUPACA" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                            <TextBlock x:Name="TxtUkupnoKupciDug" Text="0 RSD" FontSize="22" FontWeight="Bold" Foreground="#2563EB" Margin="0,6,0,0"/>
                            <TextBlock x:Name="TxtBrojKupacaDug" Text="0 kupaca sa dugovanjem" FontSize="11" Foreground="#3B82F6" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Obaveze prema Dobavljačima -->
                    <Border Background="White" CornerRadius="12" Padding="18,16" Margin="8,0,8,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="OBAVEZE PREMA DOBAVLJAČIMA" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                            <TextBlock x:Name="TxtUkupnoDobavljaciDug" Text="0 RSD" FontSize="22" FontWeight="Bold" Foreground="#7C3AED" Margin="0,6,0,0"/>
                            <TextBlock x:Name="TxtBrojDobavljaciDug" Text="0 dobavljača neplaćeno" FontSize="11" Foreground="#8B5CF6" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Neto Saldo Likvidnosti -->
                    <Border Background="White" CornerRadius="12" Padding="18,16" Margin="8,0,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="NETO LIKVIDNOST (KUPCI - DOBAVLJAČI)" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                            <TextBlock x:Name="TxtNetoSaldoLikvidnost" Text="0 RSD" FontSize="22" FontWeight="Bold" Foreground="#059669" Margin="0,6,0,0"/>
                            <TextBlock x:Name="TxtNetoOpis" Text="Pozitivan neto priliv" FontSize="11" Foreground="#10B981" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </StackPanel>

            <!-- 👥 RED 2: TOP PARTNERI PO OTVORENIM STAVKAMA (IOS PREGLED) -->
            <Grid Grid.Row="2" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Top Kupci (Potraživanja) -->
                <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="👥 Top 5 Kupaca sa najvećim dugom" FontSize="14" FontWeight="Bold" Foreground="#1E293B"/>
                        </StackPanel>
                        <DataGrid x:Name="DgTopKupci" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="Transparent" BorderThickness="0" RowHeight="32">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Konto" Binding="{Binding BrojKonta}" Width="70"/>
                                <DataGridTextColumn Header="Naziv Kupca" Binding="{Binding NazivPartnera}" Width="*" MinWidth="130"/>
                                <DataGridTextColumn Header="Saldo (RSD)" Binding="{Binding Saldo, StringFormat=\{0:N2\}}" Width="120" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                                <DataGridTemplateColumn Width="75">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="📄 IOS" Padding="4,2" FontSize="11" Click="BtnPrintPartnerIos_Click" CommandParameter="{Binding}" Style="{StaticResource ActionButtonStyle}" Height="24"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <!-- Top Dobavljači (Obaveze) -->
                <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="🏢 Top 5 Dobavljača po neizmirenim obavezama" FontSize="14" FontWeight="Bold" Foreground="#1E293B"/>
                        </StackPanel>
                        <DataGrid x:Name="DgTopDobavljaci" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="Transparent" BorderThickness="0" RowHeight="32">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Konto" Binding="{Binding BrojKonta}" Width="70"/>
                                <DataGridTextColumn Header="Naziv Dobavljača" Binding="{Binding NazivPartnera}" Width="*" MinWidth="130"/>
                                <DataGridTextColumn Header="Obaveza (RSD)" Binding="{Binding UkupnoPotrazuje, StringFormat=\{0:N2\}}" Width="120" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                                <DataGridTemplateColumn Width="75">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="📄 IOS" Padding="4,2" FontSize="11" Click="BtnPrintPartnerIos_Click" CommandParameter="{Binding}" Style="{StaticResource ActionButtonStyle}" Height="24"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- 📊 RED 3: GRAFIKONI -->
            <Grid Grid.Row="3" Margin="0,0,0,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="300"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="340"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="280"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*" MinWidth="280"/>
                </Grid.ColumnDefinitions>

                <!-- Status naloga (Donut) -->
                <Border Grid.Row="0" Grid.Column="0" Background="White" CornerRadius="12" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Status naloga za knjiženje" FontWeight="Bold" FontSize="14" Foreground="#1E293B" Margin="0,0,0,10"/>
                        <lvc:PieChart x:Name="PieStatusNaloga" Grid.Row="1" LegendPosition="Right"/>
                    </Grid>
                </Border>

                <!-- Statistika Naloga i Konta -->
                <Border Grid.Row="0" Grid.Column="2" Background="White" CornerRadius="12" Padding="20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Statistika Glavne Knjige" FontWeight="Bold" FontSize="14" Foreground="#1E293B" Margin="0,0,0,16"/>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Proknjiženo naloga:" Foreground="#64748B" FontSize="13"/>
                            <TextBlock x:Name="TxtUkupnoNaloga" Text="0" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Right" FontSize="14"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Ukupno stavki knjiženja:" Foreground="#64748B" FontSize="13"/>
                            <TextBlock x:Name="TxtStavkiKnjizenja" Text="0" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Right" FontSize="14"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Neproknjiženi nalozi:" Foreground="#64748B" FontSize="13"/>
                            <TextBlock x:Name="TxtNeproknjizenoNaloga" Text="0" FontWeight="Bold" Foreground="#D97706" HorizontalAlignment="Right" FontSize="14"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Broj aktivnih konta:" Foreground="#64748B" FontSize="13"/>
                            <TextBlock x:Name="TxtUkupnoKonta" Text="0" FontWeight="Bold" Foreground="#059669" HorizontalAlignment="Right" FontSize="14"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="Broj registrovanih partnera:" Foreground="#64748B" FontSize="13"/>
                            <TextBlock x:Name="TxtUkupnoPartnera" Text="0" FontWeight="Bold" Foreground="#7C3AED" HorizontalAlignment="Right" FontSize="14"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Promet po kontu Top 10 -->
                <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Background="White" CornerRadius="12" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Top 10 konta po ukupnom prometu (RSD)" FontWeight="Bold" FontSize="14" Foreground="#1E293B" Margin="0,0,0,10"/>
                        <lvc:CartesianChart x:Name="BarPrometKonta" Grid.Row="1"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- 📝 RED 4: POSLEDNJI NALOZI I INFO O FIRMI -->
            <Grid Grid.Row="4" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <DockPanel>
                        <TextBlock Text="Poslednji proknjiženi nalozi" FontSize="15" FontWeight="Bold" Foreground="#1E293B" DockPanel.Dock="Top" Margin="0,0,0,14"/>
                        <DataGrid x:Name="DgRecentNalozi" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="Transparent" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Br. naloga" Binding="{Binding BrojNaloga}" Width="100"/>
                                <DataGridTextColumn Header="Datum" Binding="{Binding DatumNaloga, StringFormat=\{0:dd.MM.yyyy\}}" Width="95"/>
                                <DataGridTextColumn Header="Opis" Binding="{Binding Opis}" Width="*" MinWidth="110"/>
                                <DataGridTextColumn Header="Duguje (RSD)" Binding="{Binding UkupnoDuguje, StringFormat=\{0:N2\}}" Width="120" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                                <DataGridTextColumn Header="Potražuje (RSD)" Binding="{Binding UkupnoPotrazuje, StringFormat=\{0:N2\}}" Width="120" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Podaci o firmi" FontSize="15" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,14"/>

                        <TextBlock Text="Naziv firme:" FontWeight="Bold" Foreground="#64748B" FontSize="11"/>
                        <TextBlock x:Name="TxtFirmaNaziv" Text="—" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,2,0,10"/>

                        <TextBlock Text="Adresa:" FontWeight="Bold" Foreground="#64748B" FontSize="11"/>
                        <TextBlock x:Name="TxtFirmaAdresa" Text="—" FontSize="13" Foreground="#0F172A" Margin="0,2,0,10"/>

                        <TextBlock Text="Žiro račun:" FontWeight="Bold" Foreground="#64748B" FontSize="11"/>
                        <TextBlock x:Name="TxtFirmaZiro" Text="—" FontSize="13" Foreground="#0F172A" Margin="0,2,0,10"/>

                        <TextBlock Text="Status baze:" FontWeight="Bold" Foreground="#64748B" FontSize="11"/>
                        <Border Background="#ECFDF5" CornerRadius="6" Padding="10,6" Margin="0,4,0,0">
                            <TextBlock Text="✅ Legacy DBF podaci uvezeni u SQLite!" FontSize="12" FontWeight="SemiBold" Foreground="#047857"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
