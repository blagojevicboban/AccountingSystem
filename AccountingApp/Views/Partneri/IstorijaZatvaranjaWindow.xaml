<Window x:Class="AccountingApp.Views.Partneri.IstorijaZatvaranjaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Istorija zatvaranja stavki" Height="560" Width="960"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="16,12" Margin="0,0,0,16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <DockPanel>
                <TextBlock x:Name="TxtNaslov" Text="🕘 Istorija zatvaranja" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                <Button x:Name="BtnOtkaziZatvaranje" Content="↩️ Otkaži zatvaranje" DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource ActionButtonStyle}" Background="#DC2626" Click="BtnOtkaziZatvaranje_Click"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <DataGrid x:Name="DgIstorija" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="Transparent" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Datum zatvaranja" Binding="{Binding DatumZatvaranja, StringFormat=\{0:dd.MM.yyyy\}}" Width="120"/>
                    <DataGridTextColumn Header="Duguje — dokument" Binding="{Binding StavkaDuguje.BrojDokumenta}" Width="140"/>
                    <DataGridTextColumn Header="Potražuje — dokument" Binding="{Binding StavkaPotrazuje.BrojDokumenta}" Width="150"/>
                    <DataGridTextColumn Header="Iznos (RSD)" Binding="{Binding Iznos, StringFormat=\{0:N2\}}" Width="110" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                    <DataGridTextColumn Header="Vrsta" Binding="{Binding VrstaZatvaranja}" Width="110"/>
                    <DataGridTextColumn Header="Napomena" Binding="{Binding Napomena}" Width="*"/>
                    <DataGridTextColumn Header="Korisnik" Binding="{Binding KorisnickoIme}" Width="110"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>
