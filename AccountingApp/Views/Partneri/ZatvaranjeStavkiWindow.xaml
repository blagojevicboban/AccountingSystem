<Window x:Class="AccountingApp.Views.Partneri.ZatvaranjeStavkiWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zatvaranje otvorenih stavki" Height="680" Width="1200"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="16,12" Margin="0,0,0,16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <TextBlock x:Name="TxtNaslov" Text="🔗 Zatvaranje otvorenih stavki" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="16" Margin="0,0,8,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <DockPanel>
                    <TextBlock Text="Duguje (npr. fakture)" FontSize="13" FontWeight="Bold" DockPanel.Dock="Top" Margin="0,0,0,10"/>
                    <DataGrid x:Name="DgDuguje" AutoGenerateColumns="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="Transparent" BorderThickness="0" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="✓" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="34"/>
                            <DataGridTextColumn Header="Datum" Binding="{Binding Datum, StringFormat=\{0:dd.MM.yyyy\}}" Width="80" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Dokument" Binding="{Binding BrojDokumenta}" Width="90" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Opis" Binding="{Binding Opis}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Preostalo" Binding="{Binding Preostalo, StringFormat=\{0:N2\}}" Width="90" IsReadOnly="True" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                            <DataGridTextColumn Header="Za zatvaranje" Binding="{Binding IznosZaZatvaranje, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}" Width="100" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="16" Margin="8,0,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <DockPanel>
                    <TextBlock Text="Potražuje (npr. uplate)" FontSize="13" FontWeight="Bold" DockPanel.Dock="Top" Margin="0,0,0,10"/>
                    <DataGrid x:Name="DgPotrazuje" AutoGenerateColumns="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="Transparent" BorderThickness="0" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="✓" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="34"/>
                            <DataGridTextColumn Header="Datum" Binding="{Binding Datum, StringFormat=\{0:dd.MM.yyyy\}}" Width="80" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Dokument" Binding="{Binding BrojDokumenta}" Width="90" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Opis" Binding="{Binding Opis}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Preostalo" Binding="{Binding Preostalo, StringFormat=\{0:N2\}}" Width="90" IsReadOnly="True" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                            <DataGridTextColumn Header="Za zatvaranje" Binding="{Binding IznosZaZatvaranje, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}" Width="100" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="16,12" Margin="0,16,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Zbir duguje: " VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtZbirDuguje" Text="0,00" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,16,0"/>
                    <TextBlock Text="Zbir potražuje: " VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtZbirPotrazuje" Text="0,00" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,16,0"/>
                    <Button x:Name="BtnPotvrdi" Content="🔗 Zatvori stavke" Style="{StaticResource ActionButtonStyle}" Click="BtnPotvrdi_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Datum:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <DatePicker x:Name="DpDatum" Width="120" Height="32" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <TextBlock Text="Vrsta:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="CmbVrstaZatvaranja" Width="130" Height="32" VerticalAlignment="Center" Margin="0,0,16,0" SelectedIndex="0">
                        <ComboBoxItem Content="Rucno"/>
                        <ComboBoxItem Content="Kompenzacija"/>
                    </ComboBox>
                    <TextBlock Text="Napomena:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="TxtNapomena" Width="220" Height="32" VerticalContentAlignment="Center" Padding="6,0"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
