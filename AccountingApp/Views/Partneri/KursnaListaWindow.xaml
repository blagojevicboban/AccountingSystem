<Window x:Class="AccountingApp.Views.Partneri.KursnaListaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="💱 Zvanična Kursna Lista Narodne Banke Srbije (NBS)" Height="620" Width="850"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="💱 Zvanična Dnevna Kursna Lista NBS" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
            <TextBlock Text="Zvanični srednji, kupovni i prodajni kursevi deviza Narodne banke Srbije." FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Filter & Akcije -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Kursna lista na dan:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                <DatePicker Grid.Column="1" x:Name="DpDatumKurseve" Height="34" VerticalContentAlignment="Center"/>

                <Button Grid.Column="3" Content="🔄 Preuzmi sa NBS" Style="{StaticResource ActionButtonStyle}" Height="34" Padding="16,0" Click="BtnOsvezi_Click"/>
            </Grid>
        </Border>

        <!-- DataGrid kurseva -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0" x:Name="DgKursevi" AutoGenerateColumns="False" IsReadOnly="True"
                      Background="{StaticResource SurfaceBrush}" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"
                      GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Valuta" Binding="{Binding ValutaOznaka}" FontWeight="Bold" Width="80"/>
                    <DataGridTextColumn Header="Naziv" Binding="{Binding NazivValute}" Width="*"/>
                    <DataGridTextColumn Header="Jedinica" Binding="{Binding Jedinica}" Width="65" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                    <DataGridTextColumn Header="Srednji kurs (RSD)" Binding="{Binding SrednjiKurs, StringFormat=N4}" Width="130" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                    <DataGridTextColumn Header="Kupovni kurs" Binding="{Binding KupovniKurs, StringFormat=N4}" Width="110" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                    <DataGridTextColumn Header="Prodajni kurs" Binding="{Binding ProdavniKurs, StringFormat=N4}" Width="110" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Kalkulator Konverzije Valuta -->
            <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="🧮 Kalkulator Konverzije Valuta" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,12"/>

                    <TextBlock Text="Iznos u devizama" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtIznosDevize" Text="100.00" Height="34" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,10" TextChanged="Kalkulator_InputChanged"/>

                    <TextBlock Text="Izaberite valutu" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbValuta" Height="34" VerticalContentAlignment="Center" Margin="0,0,0,14" SelectionChanged="CmbValuta_SelectionChanged">
                        <ComboBoxItem Content="EUR — Evro" IsSelected="True"/>
                        <ComboBoxItem Content="USD — Američki dolar"/>
                        <ComboBoxItem Content="CHF — Švajcarski franak"/>
                        <ComboBoxItem Content="GBP — Britanska funta"/>
                        <ComboBoxItem Content="BAM — Konvertibilna marka"/>
                    </ComboBox>

                    <Border Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,4,0,0">
                        <StackPanel>
                            <TextBlock Text="Protivvrednost u dinarima (RSD):" FontSize="12" Foreground="#0369A1" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtRezultatRsd" Text="11,718.50 RSD" FontSize="18" FontWeight="Bold" Foreground="#0284C7" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <TextBlock x:Name="TxtStatus" Text="Kursna lista je sprema." VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
            <Button Content="Zatvori" Width="100" Height="34" HorizontalAlignment="Right" Click="BtnZatvori_Click"/>
        </Grid>
    </Grid>
</Window>
