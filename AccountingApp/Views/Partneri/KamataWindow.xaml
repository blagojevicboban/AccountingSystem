<Window x:Class="AccountingApp.Views.Partneri.KamataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Obračun kamate" Height="640" Width="1000"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="16" Margin="0,0,16,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <DockPanel>
                <TextBlock Text="💰 Kamatne stope" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextBrush}" DockPanel.Dock="Top" Margin="0,0,0,12"/>

                <StackPanel DockPanel.Dock="Bottom">
                    <TextBlock Text="Nova stopa — važi od:" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                    <DatePicker x:Name="DpNovaStopaOd" Height="32" Margin="0,0,0,8"/>
                    <TextBlock Text="Godišnja stopa (%)" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtNovaStopaProcenat" Height="32" VerticalContentAlignment="Center" Padding="6,0" Margin="0,0,0,8"/>
                    <Button x:Name="BtnDodajStopu" Content="➕ Dodaj stopu" Style="{StaticResource ActionButtonStyle}" Click="BtnDodajStopu_Click"/>
                </StackPanel>

                <DataGrid x:Name="DgStope" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="Transparent" BorderThickness="0" Margin="0,0,0,12">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Važi od" Binding="{Binding DatumOd, StringFormat=\{0:dd.MM.yyyy\}}" Width="90"/>
                        <DataGridTextColumn Header="Stopa (%)" Binding="{Binding GodisnjaStopaProcenat, StringFormat=N2}" Width="*" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="16,12" Margin="0,0,0,16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtNaslovPartnera" Text="Partner" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="0,0,20,0"/>
                        <TextBlock Text="Datum obračuna:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                        <DatePicker x:Name="DpDatumObracuna" Width="140" Height="32" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button x:Name="BtnObracunaj" Content="🧮 Obračunaj" Style="{StaticResource ActionButtonStyle}" Margin="0,0,10,0" Click="BtnObracunaj_Click"/>
                        <Button x:Name="BtnStampajKamatu" Content="📥 Izvezi PDF" Style="{StaticResource ActionButtonStyle}" Background="#7C3AED" Click="BtnStampajKamatu_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <DockPanel>
                    <Border DockPanel.Dock="Bottom" Margin="0,12,0,0" Padding="16,10" CornerRadius="8" Background="#F1F5F9">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="Ukupna kamata: " FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtUkupnaKamata" Text="0,00" FontSize="16" FontWeight="Bold" Foreground="#7C3AED"/>
                        </StackPanel>
                    </Border>

                    <DataGrid x:Name="DgKamata" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="Transparent" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Datum duga" Binding="{Binding Datum, StringFormat=\{0:dd.MM.yyyy\}}" Width="100"/>
                            <DataGridTextColumn Header="Br. naloga" Binding="{Binding BrojNaloga}" Width="100"/>
                            <DataGridTextColumn Header="Opis" Binding="{Binding Opis}" Width="*"/>
                            <DataGridTextColumn Header="Iznos (RSD)" Binding="{Binding Iznos, StringFormat=\{0:N2\}}" Width="120" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                            <DataGridTextColumn Header="Dana kašnjenja" Binding="{Binding BrojDanaKasnjenja}" Width="110" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                            <DataGridTextColumn Header="Kamata (RSD)" Binding="{Binding ObracunataKamata, StringFormat=\{0:N2\}}" Width="120" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
