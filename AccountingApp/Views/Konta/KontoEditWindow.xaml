<Window x:Class="AccountingApp.Views.Konta.KontoEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Konto" Height="650" Width="460" WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TxtHeader" Text="➕ Unos novog konta" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,12"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,6,0">
                <TextBlock Text="Broj konta *" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,2"/>
                <TextBox x:Name="TxtBrojKonta" Height="32" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,8" MaxLength="20"/>

                <TextBlock Text="Naziv konta *" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,2"/>
                <TextBox x:Name="TxtNazivKonta" Height="32" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,8" MaxLength="200"/>

                <TextBlock Text="Stari konto" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,2"/>
                <TextBox x:Name="TxtStariKonto" Height="32" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,8" MaxLength="20"/>

                <TextBlock Text="Ulica" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,2"/>
                <TextBox x:Name="TxtUlica" Height="32" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,8" MaxLength="50"/>

                <TextBlock Text="Mesto" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,2"/>
                <TextBox x:Name="TxtMesto" Height="32" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,8" MaxLength="50"/>

                <TextBlock Text="Žiro račun" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,2"/>
                <TextBox x:Name="TxtZiroRacun" Height="32" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,8" MaxLength="50"/>

                <TextBlock Text="Telefon" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,2"/>
                <TextBox x:Name="TxtTelefon" Height="32" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,8" MaxLength="50"/>

                <TextBlock Text="Vrsta konta" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,2"/>
                <ComboBox x:Name="CmbVrstaKonta" Height="32" VerticalContentAlignment="Center" Padding="8,0" SelectedIndex="0" Margin="0,0,0,8">
                    <ComboBoxItem Content="Aktivna"/>
                    <ComboBoxItem Content="Pasivna"/>
                    <ComboBoxItem Content="Vanbilansna"/>
                </ComboBox>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Odustani" Width="100" Height="36" Margin="0,0,10,0" Background="#E2E8F0" Foreground="#334155" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" Click="BtnOdustani_Click"/>
            <Button Content="💾 Sačuvaj" Width="110" Height="36" Style="{StaticResource ActionButtonStyle}" Click="BtnSacuvaj_Click"/>
        </StackPanel>
    </Grid>
</Window>
