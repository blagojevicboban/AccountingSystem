<Window x:Class="AccountingApp.Views.Firme.FirmaEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Podaci o firmi"
        Height="540" Width="550"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource BackgroundBrush}">

    <Border Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,15">
                <TextBlock x:Name="TxtTitle" Text="🏢 Dodavanje nove firme" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                <TextBlock Text="Unesite osnovne identifikacione i kontakt podatke o firmi." FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Form -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,10,0">
                    <!-- Šifra i Status -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Šifra firme *" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtSifra" Height="34" VerticalContentAlignment="Center" Padding="8,0" MaxLength="20"/>
                        </StackPanel>

                        <CheckBox x:Name="ChkIsActive" Grid.Column="2" Content="Firma je aktivna" IsChecked="True" VerticalAlignment="Bottom" Margin="0,0,0,8" FontWeight="SemiBold"/>
                    </Grid>

                    <!-- Naziv -->
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Naziv firme / preduzeća *" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtNaziv" Height="34" VerticalContentAlignment="Center" Padding="8,0" MaxLength="200"/>
                    </StackPanel>

                    <!-- PIB i MB -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="PIB" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtPib" Height="34" VerticalContentAlignment="Center" Padding="8,0" MaxLength="30"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Matični broj" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtMaticniBroj" Height="34" VerticalContentAlignment="Center" Padding="8,0" MaxLength="30"/>
                        </StackPanel>
                    </Grid>

                    <!-- Adresa -->
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Adresa (Ulica i broj)" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtAdresa" Height="34" VerticalContentAlignment="Center" Padding="8,0" MaxLength="200"/>
                    </StackPanel>

                    <!-- PTT i Mesto -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="PTT i Mesto" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtPttIMesto" Height="34" VerticalContentAlignment="Center" Padding="8,0" MaxLength="100"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Telefon" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtTelefon" Height="34" VerticalContentAlignment="Center" Padding="8,0" MaxLength="50"/>
                        </StackPanel>
                    </Grid>

                    <!-- Žiro račun -->
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Žiro / Tekući račun" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtZiroRacun" Height="34" VerticalContentAlignment="Center" Padding="8,0" MaxLength="50"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                <Button Content="Otkaži" Width="100" Height="36" Margin="0,0,10,0"
                        Background="#F1F5F9" Foreground="#475569" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand"
                        Click="BtnCancel_Click"/>
                <Button Content="Sačuvaj" Style="{StaticResource ActionButtonStyle}" Width="120"
                        Click="BtnSave_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
