<Window x:Class="AccountingApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AccountingSystem — Finansijsko knjigovodstvo i glavna knjiga"
        Icon="/app.ico"
        Height="768" Width="1280"
        MinHeight="650" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="{StaticResource SidebarStartColor}" Offset="0"/>
                    <GradientStop Color="{StaticResource SidebarEndColor}" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20,20,20,15">
                    <TextBlock Text="💼 KNJIGOVODSTVO" FontSize="20" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Glavna knjiga i ERP" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                </StackPanel>

                <Border DockPanel.Dock="Top" Margin="16,0,16,15" Background="#1E293B" CornerRadius="8" Padding="12,10"
                        Cursor="Hand" MouseDown="FirmaBorder_MouseDown">
                    <StackPanel>
                        <TextBlock Text="Aktivna firma:" FontSize="10" Foreground="#64748B" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtFirmaNaziv" Text="—" FontSize="13" FontWeight="SemiBold" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        <TextBlock x:Name="TxtFirmaSifra" Text="—" FontSize="11" Foreground="#38BDF8"/>
                    </StackPanel>
                </Border>

                <Separator DockPanel.Dock="Top" Background="#334155" Margin="16,0,16,10"/>

                <!-- Korisnik info i Odjava -->
                <Border DockPanel.Dock="Bottom" Margin="16,0,16,12" Background="#1E293B" CornerRadius="8" Padding="12,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="TxtImeKorisnika" Text="Prijavljeni korisnik" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock x:Name="TxtUlogaKorisnika" Grid.Row="1" Text="Uloga" FontSize="10" Foreground="#38BDF8" Margin="0,2,0,0"/>
                        <Button x:Name="BtnOdjava" Grid.Row="3" Content="Odjavi se" FontSize="11" Padding="4,4"
                                Foreground="#38BDF8" BorderBrush="#38BDF8" BorderThickness="1" Background="Transparent"
                                Cursor="Hand" Click="BtnOdjava_Click"/>
                    </Grid>
                </Border>

                <!-- Verzija dole -->
                <TextBlock DockPanel.Dock="Bottom" x:Name="VersionText" Text="v1.0.0  •  2026"
                           FontSize="11" Foreground="#38BDF8" TextAlignment="Center" Margin="0,0,0,12"
                           Cursor="Hand" ToolTip="Kliknite za prikaz istorije izmena (Changelog)"
                           MouseLeftButtonDown="VersionText_MouseLeftButtonDown"/>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PnlNavigation">
                        <TextBlock Text="EVIDENCIJA" FontSize="10" FontWeight="SemiBold"
                                   Foreground="#38BDF8" Margin="24,2,0,3"/>
                        <RadioButton x:Name="BtnDashboard" Content="📊 Radna tabla" Style="{StaticResource NavButtonStyle}" IsChecked="True" Click="NavDashboard_Click"/>
                        <RadioButton x:Name="BtnKonta" Content="📋 Kontni plan" Style="{StaticResource NavButtonStyle}" Click="NavKonta_Click"/>
                        <RadioButton x:Name="BtnNalozi" Content="📖 Glavna knjiga" Style="{StaticResource NavButtonStyle}" Click="NavNalozi_Click"/>
                        <RadioButton x:Name="BtnKartice" Content="📋 Kartice konta" Style="{StaticResource NavButtonStyle}" Click="NavKartice_Click"/>
                        <RadioButton x:Name="BtnPartneri" Content="👥 Partneri (Analitika)" Style="{StaticResource NavButtonStyle}" Click="NavPartneri_Click"/>

                        <Separator Background="#334155" Margin="16,8"/>
                        <TextBlock Text="MAGACIN I TRGOVINA" FontSize="10" FontWeight="SemiBold"
                                   Foreground="#38BDF8" Margin="24,2,0,3"/>
                        <RadioButton x:Name="BtnMagacin" Content="📦 Magacin i zalihe" Style="{StaticResource NavButtonStyle}" Click="NavMagacin_Click"/>
                        <RadioButton x:Name="BtnKalkulacije" Content="🛒 Trgovina i fakture" Style="{StaticResource NavButtonStyle}" Click="NavKalkulacije_Click"/>

                        <Separator Background="#334155" Margin="16,8"/>
                        <TextBlock Text="IZVEŠTAJI" FontSize="10" FontWeight="SemiBold"
                                   Foreground="#38BDF8" Margin="24,2,0,3"/>
                        <RadioButton x:Name="BtnIzvestaji" Content="📄 Izveštaji i PDF" Style="{StaticResource NavButtonStyle}" Click="NavIzvestaji_Click"/>
                        <RadioButton x:Name="BtnBilansi" Content="🏛️ Bilansi (APR)" Style="{StaticResource NavButtonStyle}" Click="NavBilansi_Click"/>
                        <RadioButton x:Name="BtnPdv" Content="🧾 PDV Evidencija (KIR/KPR)" Style="{StaticResource NavButtonStyle}" Click="NavPdv_Click"/>

                        <Separator Background="#334155" Margin="16,8"/>
                        <TextBlock Text="PODEŠAVANJA" FontSize="10" FontWeight="SemiBold"
                                   Foreground="#38BDF8" Margin="24,2,0,3"/>
                        <RadioButton x:Name="BtnPodesavanja" Content="⚙️ Podešavanja" Style="{StaticResource NavButtonStyle}" Click="NavPodesavanja_Click"/>
                        <RadioButton x:Name="BtnKorisnici" Content="👤 Korisnici i Uloge" Style="{StaticResource NavButtonStyle}" Click="NavKorisnici_Click"/>

                        <Separator Background="#334155" Margin="16,8"/>
                        <TextBlock Text="DOKUMENTACIJA" FontSize="10" FontWeight="SemiBold"
                                   Foreground="#38BDF8" Margin="24,2,0,3"/>
                        <RadioButton x:Name="BtnPomoc" Content="❓ Pomoć" Style="{StaticResource NavButtonStyle}" Click="NavPomoc_Click"/>
                        <Button x:Name="BtnChangelog" Content="📋 Istorija izmena" Click="BtnChangelog_Click"
                                Height="42" Margin="10,2" Padding="16,0" HorizontalContentAlignment="Left"
                                Background="Transparent" BorderThickness="0" Foreground="#94A3B8" FontSize="14" Cursor="Hand"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- MAIN CONTENT AREA -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,0">
                <Grid VerticalAlignment="Center">
                    <TextBlock x:Name="TxtHeaderTitle" Text="📊 Radna tabla" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>

                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#F1F5F9" CornerRadius="16" Padding="12,6">
                            <TextBlock x:Name="TxtKorisnik" Text="👤 —" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl x:Name="MainContentHost" Grid.Row="1" Margin="24"/>
        </Grid>
    </Grid>
</Window>
