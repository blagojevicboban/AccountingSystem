<Window x:Class="AccountingApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AccountingSystem — Finansijsko knjigovodstvo i glavna knjiga"
        Icon="/app.ico"
        Height="768" Width="1280"
        MinHeight="650" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="{StaticResource SidebarStartColor}" Offset="0"/>
                    <GradientStop Color="{StaticResource SidebarEndColor}" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20,20,20,12">
                    <TextBlock x:Name="TxtBrandTitle" Text="💼 KNJIGOVODSTVO" FontSize="20" FontWeight="Bold" Foreground="White"/>
                    <TextBlock x:Name="TxtBrandSubtitle" Text="Glavna knjiga i ERP" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Quick Search Bar u Meniju -->
                <Border DockPanel.Dock="Top" Margin="16,0,16,10" Background="#1E293B" CornerRadius="8" Padding="10,6">
                    <Grid x:Name="PnlSearchNav">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🔍 " FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtSearchNav" Grid.Column="1" Background="Transparent" BorderThickness="0"
                                 Foreground="#F8FAFC" FontSize="12" VerticalAlignment="Center" CaretBrush="White"
                                 GotFocus="TxtSearchNav_GotFocus" LostFocus="TxtSearchNav_LostFocus"
                                 TextChanged="TxtSearchNav_TextChanged"/>
                        <TextBlock x:Name="TxtSearchPlaceholder" Grid.Column="1" Text="Pretraži meni... (Ctrl+F)" FontSize="11" 
                                   Foreground="#64748B" IsHitTestVisible="False" VerticalAlignment="Center" Margin="2,0,0,0"/>
                    </Grid>
                </Border>

                <!-- Aktivna Firma -->
                <Border DockPanel.Dock="Top" Margin="16,0,16,15" Background="#1E293B" CornerRadius="8" Padding="12,10"
                        Cursor="Hand" MouseDown="FirmaBorder_MouseDown" ToolTip="Kliknite za promenu firme (Upravljanje firmama)">
                    <Grid x:Name="PnlFirmaDetails">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Red 1: Naslov + Dugme Promeni -->
                        <Grid Grid.Row="0">
                            <TextBlock Text="Aktivna firma:" FontSize="10" Foreground="#64748B" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Border x:Name="PnlPromeniBadge" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#334155" CornerRadius="4" Padding="5,2">
                                <TextBlock Text="🔄 Promeni" FontSize="10" FontWeight="SemiBold" Foreground="#38BDF8"/>
                            </Border>
                        </Grid>

                        <!-- Red 2: Naziv firme - pun prostor -->
                        <TextBlock x:Name="TxtFirmaNaziv" Grid.Row="1" Text="—" FontSize="13" FontWeight="SemiBold" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis" Margin="0,4,0,2"/>

                        <!-- Red 3: Šifra firme -->
                        <TextBlock x:Name="TxtFirmaSifra" Grid.Row="2" Text="—" FontSize="11" Foreground="#38BDF8"/>
                    </Grid>
                </Border>

                <Separator DockPanel.Dock="Top" Background="#334155" Margin="16,0,16,10"/>

                <!-- Korisnik info i Odjava -->
                <Border DockPanel.Dock="Bottom" Margin="16,0,16,12" Background="#1E293B" CornerRadius="8" Padding="12,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="TxtImeKorisnika" Text="Prijavljeni korisnik" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock x:Name="TxtUlogaKorisnika" Grid.Row="1" Text="Uloga" FontSize="10" Foreground="#38BDF8" Margin="0,2,0,0"/>
                        <Button x:Name="BtnOdjava" Grid.Row="3" Content="Odjavi se" FontSize="11" Padding="4,4"
                                Foreground="#38BDF8" BorderBrush="#38BDF8" BorderThickness="1" Background="Transparent"
                                Cursor="Hand" Click="BtnOdjava_Click"/>
                    </Grid>
                </Border>

                <!-- Verzija dole -->
                <TextBlock DockPanel.Dock="Bottom" x:Name="VersionText" Text="v1.0.0  •  2026"
                           FontSize="11" Foreground="#38BDF8" TextAlignment="Center" Margin="0,0,0,12"
                           Cursor="Hand" ToolTip="Kliknite za prikaz istorije izmena (Changelog)"
                           MouseLeftButtonDown="VersionText_MouseLeftButtonDown"/>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PnlNavigation">
                        <TextBlock x:Name="HeaderFinansije" Text="FINANSIJSKO KNJIGOVODSTVO" FontSize="10" FontWeight="SemiBold"
                                   Foreground="#38BDF8" Margin="24,2,0,3"/>
                        <RadioButton x:Name="BtnDashboard" Content="📊 Radna tabla" Style="{StaticResource NavButtonStyle}" IsChecked="True" Click="NavDashboard_Click" ToolTip="Radna tabla sa indikatorima i brzim akcijama"/>
                        <RadioButton x:Name="BtnFirme" Content="🏢 Upravljanje firmama" Style="{StaticResource NavButtonStyle}" Click="NavFirme_Click" ToolTip="Spisak firmi, izbor aktivne firme i kreiranje nove"/>
                        <RadioButton x:Name="BtnKonta" Content="📋 Kontni plan" Style="{StaticResource NavButtonStyle}" Click="NavKonta_Click" ToolTip="Šifarnik sintetike i analitike sa kontnim planom"/>
                        <RadioButton x:Name="BtnNalozi" Content="📖 Glavna knjiga" Style="{StaticResource NavButtonStyle}" Click="NavNalozi_Click" ToolTip="Evidencija i knjiženje naloga glavne knjige"/>
                        <RadioButton x:Name="BtnKartice" Content="📋 Kartice konta" Style="{StaticResource NavButtonStyle}" Click="NavKartice_Click" ToolTip="Pregled hronoloških kartica po kontima"/>
                        <RadioButton x:Name="BtnPartneri" Content="👥 Partneri (Analitika)" Style="{StaticResource NavButtonStyle}" Click="NavPartneri_Click" ToolTip="Analitika kupaca, dobavljača i otvorenih stavki"/>
                        <RadioButton x:Name="BtnIzvestaji" Content="📄 Finansijski izveštaji i PDF" Style="{StaticResource NavButtonStyle}" Click="NavIzvestaji_Click" ToolTip="Štampa Dnevnika GK, Bruto bilansa i IOS obrazaca"/>

                        <Separator x:Name="SepRobno" Background="#334155" Margin="16,8"/>
                        <TextBlock x:Name="HeaderRobno" Text="ROBNO KNJIGOVODSTVO I MAGACINI" FontSize="10" FontWeight="SemiBold"
                                   Foreground="#38BDF8" Margin="24,2,0,3"/>
                        <RadioButton x:Name="BtnKalkulacije" Content="📦 Robno knjigovodstvo" Style="{StaticResource NavButtonStyle}" Click="NavKalkulacije_Click" ToolTip="Kalkulacije veleprodaje/maloprodaje, otpremnice i nivelacije"/>
                        <RadioButton x:Name="BtnMagacin" Content="🏭 Ulazi i zalihe magacina" Style="{StaticResource NavButtonStyle}" Click="NavMagacin_Click" ToolTip="Prijemnice, ulazi, prateće dokumentacije i stanje magacina"/>

                        <Separator x:Name="SepPorezi" Background="#334155" Margin="16,8"/>
                        <TextBlock x:Name="HeaderPorezi" Text="POREZI I ZVANIČNI BILANSI" FontSize="10" FontWeight="SemiBold"
                                   Foreground="#38BDF8" Margin="24,2,0,3"/>
                        <RadioButton x:Name="BtnBilansi" Content="🏛️ Bilansi (APR)" Style="{StaticResource NavButtonStyle}" Click="NavBilansi_Click" ToolTip="Izrada zvaničnih finansijskih izveštaja (APR)"/>
                        <RadioButton x:Name="BtnPdv" Content="🧾 PDV Evidencija (KIR/KPR)" Style="{StaticResource NavButtonStyle}" Click="NavPdv_Click" ToolTip="Evidencija nabavki (KPR), isporuka (KIR) i POPDV prijava"/>

                        <Separator x:Name="SepPodesavanja" Background="#334155" Margin="16,8"/>
                        <TextBlock x:Name="HeaderPodesavanja" Text="PODEŠAVANJA I SISTEM" FontSize="10" FontWeight="SemiBold"
                                   Foreground="#38BDF8" Margin="24,2,0,3"/>
                        <RadioButton x:Name="BtnPodesavanja" Content="⚙️ Podešavanja" Style="{StaticResource NavButtonStyle}" Click="NavPodesavanja_Click" ToolTip="Osnovna podešavanja aplikacije, putanje i parametri"/>
                        <RadioButton x:Name="BtnBackup" Content="💾 Rezervne kopije (Backup)" Style="{StaticResource NavButtonStyle}" Click="NavBackup_Click" ToolTip="Izrada ručnih i automatskih kopija i restauracija baze"/>
                        <RadioButton x:Name="BtnKorisnici" Content="👤 Korisnici i Uloge" Style="{StaticResource NavButtonStyle}" Click="NavKorisnici_Click" ToolTip="Administracija korisnika, lozinki i uloga (RBAC)"/>

                        <Separator x:Name="SepDokumentacija" Background="#334155" Margin="16,8"/>
                        <TextBlock x:Name="HeaderDokumentacija" Text="DOKUMENTACIJA" FontSize="10" FontWeight="SemiBold"
                                   Foreground="#38BDF8" Margin="24,2,0,3"/>
                        <RadioButton x:Name="BtnPomoc" Content="❓ Pomoć" Style="{StaticResource NavButtonStyle}" Click="NavPomoc_Click" ToolTip="Korisničko uputstvo i tehnička podrška"/>
                        <Button x:Name="BtnChangelog" Content="📋 Istorija izmena" Click="BtnChangelog_Click" ToolTip="Prikaz verzija i ažuriranja aplikacije"
                                Height="42" Margin="10,2" Padding="16,0" HorizontalContentAlignment="Left"
                                Background="Transparent" BorderThickness="0" Foreground="#94A3B8" FontSize="14" Cursor="Hand"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- MAIN CONTENT AREA -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,0">
                <Grid VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnToggleSidebar" Content="☰" FontSize="16" FontWeight="Bold" Width="36" Height="36" 
                                Background="#F1F5F9" Foreground="#334155" BorderThickness="0" Margin="0,0,16,0" Cursor="Hand"
                                ToolTip="Sklopi / Proširi bočni meni (Ctrl+M)" Click="BtnToggleSidebar_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <TextBlock x:Name="TxtHeaderTitle" Text="📊 Radna tabla" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#F1F5F9" CornerRadius="16" Padding="12,6">
                            <TextBlock x:Name="TxtKorisnik" Text="👤 —" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl x:Name="MainContentHost" Grid.Row="1" Margin="24"/>
        </Grid>
    </Grid>
</Window>
