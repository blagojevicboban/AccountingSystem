<Window x:Class="AccountingApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AccountingSystem — Accounting &amp; General Ledger ERP"
        Height="768" Width="1280"
        MinHeight="650" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="{StaticResource SidebarStartColor}" Offset="0"/>
                    <GradientStop Color="{StaticResource SidebarEndColor}" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20,20,20,15">
                    <TextBlock Text="💼 ACCOUNTING" FontSize="20" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="General Ledger &amp; ERP" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                </StackPanel>

                <Border DockPanel.Dock="Top" Margin="16,0,16,15" Background="#1E293B" CornerRadius="8" Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="Active Company:" FontSize="10" Foreground="#64748B" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtFirmaNaziv" Text="ARHIBEL - 2026" FontSize="13" FontWeight="SemiBold" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        <TextBlock Text="KOR01 • Pirot" FontSize="11" Foreground="#38BDF8"/>
                    </StackPanel>
                </Border>

                <Separator DockPanel.Dock="Top" Background="#334155" Margin="16,0,16,10"/>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PnlNavigation">
                        <RadioButton Content="📊 Dashboard" Style="{StaticResource NavButtonStyle}" IsChecked="True" Click="NavDashboard_Click"/>
                        <RadioButton Content="📖 General Ledger" Style="{StaticResource NavButtonStyle}" Click="NavNalozi_Click"/>
                        <RadioButton Content="📋 Account Cards" Style="{StaticResource NavButtonStyle}" Click="NavKartice_Click"/>
                        <RadioButton Content="👥 Subledger (Partners)" Style="{StaticResource NavButtonStyle}" Click="NavPartneri_Click"/>
                        <RadioButton Content="📦 Inventory &amp; Stock" Style="{StaticResource NavButtonStyle}" Click="NavMagacin_Click"/>
                        <RadioButton Content="🛒 Trade &amp; Invoices" Style="{StaticResource NavButtonStyle}" Click="NavKalkulacije_Click"/>
                        <RadioButton Content="📄 Reports &amp; PDF" Style="{StaticResource NavButtonStyle}" Click="NavIzvestaji_Click"/>
                        <RadioButton Content="🏢 Companies" Style="{StaticResource NavButtonStyle}" Click="NavFirme_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- MAIN CONTENT AREA -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,0">
                <Grid VerticalAlignment="Center">
                    <TextBlock x:Name="TxtHeaderTitle" Text="📊 Dashboard" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                    
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#F1F5F9" CornerRadius="16" Padding="12,6" Margin="0,0,12,0">
                            <TextBlock Text="👤 Administrator" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                        </Border>
                        <Button Content="DOS Legacy Import" Style="{StaticResource ActionButtonStyle}" Click="BtnUvozDOS_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl x:Name="MainContentHost" Grid.Row="1" Margin="24"/>
        </Grid>
    </Grid>
</Window>
