<Window x:Class="ERPiFinansijeApp.Views.Partneri.PartnerEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Izmena podataka partnera" Height="520" Width="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="16,12" Margin="0,0,0,16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock x:Name="TxtNaslov" Text="✏️ Izmena podataka partnera" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                <TextBlock x:Name="TxtNapomenaPromocija" Text="Partner je legacy analitički konto bez matičnog zapisa — čuvanjem se kreira pravi partner i povezuje sa dosadašnjom istorijom ovog konta." FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Naziv" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtNaziv" Height="32" VerticalContentAlignment="Center" Padding="6,0" Margin="0,0,0,12"/>

                <TextBlock Text="Konto partnera" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                <ComboBox x:Name="CmbKonto" Height="32" VerticalContentAlignment="Center" Margin="0,0,0,12"/>

                <TextBlock Text="Adresa" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtAdresa" Height="32" VerticalContentAlignment="Center" Padding="6,0" Margin="0,0,0,12"/>

                <TextBlock Text="PTT i mesto" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtPttIMesto" Height="32" VerticalContentAlignment="Center" Padding="6,0" Margin="0,0,0,12"/>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="PIB" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtPib" Height="32" VerticalContentAlignment="Center" Padding="6,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Matični broj" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtMaticniBroj" Height="32" VerticalContentAlignment="Center" Padding="6,0"/>
                    </StackPanel>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Telefon" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtTelefon" Height="32" VerticalContentAlignment="Center" Padding="6,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Žiro račun" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtZiroRacun" Height="32" VerticalContentAlignment="Center" Padding="6,0"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="BtnOtkazi" Content="Otkaži" Style="{StaticResource ActionButtonStyle}" Background="#64748B" Margin="0,0,10,0" Click="BtnOtkazi_Click"/>
            <Button x:Name="BtnSacuvaj" Content="💾 Sačuvaj" Style="{StaticResource ActionButtonStyle}" Click="BtnSacuvaj_Click"/>
        </StackPanel>
    </Grid>
</Window>
