<Window x:Class="ERPiFinansijeApp.Views.Magacin.MaterijalEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Materijal" Height="340" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}" KeyDown="Window_KeyDown">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TxtNaslov" Text="🧱 Izmena materijala" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Grid.Row="0" Margin="0,0,0,16"/>

        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <StackPanel VerticalAlignment="Center">
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Šifra materijala *" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                    <TextBox x:Name="TxtSifra" Grid.Column="1" Height="34" VerticalContentAlignment="Center" Padding="8,0" MaxLength="20"/>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Naziv materijala *" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                    <TextBox x:Name="TxtNaziv" Grid.Column="1" Height="34" VerticalContentAlignment="Center" Padding="8,0" MaxLength="200"/>
                </Grid>

                <Grid Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Jedinica mere *" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
                    <ComboBox x:Name="CmbJedinicaMere" Grid.Column="1" Height="34" VerticalContentAlignment="Center" IsEditable="True">
                        <ComboBoxItem Content="kom" IsSelected="True"/>
                        <ComboBoxItem Content="kg"/>
                        <ComboBoxItem Content="m"/>
                        <ComboBoxItem Content="l"/>
                        <ComboBoxItem Content="pak"/>
                        <ComboBoxItem Content="m2"/>
                        <ComboBoxItem Content="m3"/>
                        <ComboBoxItem Content="lit"/>
                    </ComboBox>

                    <TextBlock Text="Pakovanje" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBox x:Name="TxtPakovanje" Grid.Column="3" Height="34" VerticalContentAlignment="Center" Padding="8,0" MaxLength="50"/>
                </Grid>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="BtnOtkazi" Content="Odustani" Width="100" Height="36" Margin="0,0,10,0" Click="BtnOtkazi_Click"/>
            <Button x:Name="BtnSacuvaj" Content="💾 Sačuvaj" Width="110" Height="36" Style="{StaticResource ActionButtonStyle}" Click="BtnSacuvaj_Click"/>
        </StackPanel>
    </Grid>
</Window>
