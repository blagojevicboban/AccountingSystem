<Window x:Class="ERPiFinansijeApp.Views.PutniNalozi.IzvozZaZaradeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="📤 Izvoz prekoračenja dnevnice za ERPiZarade"
        Height="560" Width="760"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Period -->
            <RowDefinition Height="*"/>    <!-- Stavke -->
            <RowDefinition Height="Auto"/> <!-- Nalazi -->
            <RowDefinition Height="Auto"/> <!-- Footer -->
        </Grid.RowDefinitions>

        <Border Grid.Row="0" CornerRadius="8" Padding="16,10" Margin="0,0,0,12">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#0D9488" Offset="0"/>
                    <GradientStop Color="#059669" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel>
                <TextBlock Text="Izvoz prekoračenja dnevnice za ERPiZarade" FontSize="16" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Deo dnevnice iznad zakonskog neoporezivog iznosa — samo dnevnice u zemlji, samo proknjiženi nalozi."
                           FontSize="11" Foreground="#CCFBF1" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="14" Margin="0,0,0,10" BorderBrush="#E2E8F0" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Mesec isplate dnevnice:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"
                           ToolTip="Mesec kome prekoračenje pripada za PPP-PD — po datumu povratka sa puta, ne mesec putovanja ako se razlikuju."/>
                <ComboBox x:Name="CmbMesec" Width="140" Height="32" Margin="0,0,10,0"/>
                <ComboBox x:Name="CmbGodina" Width="100" Height="32" Margin="0,0,16,0"/>
                <Button x:Name="BtnPripremi" Content="🔎 Pripremi izvoz" Style="{StaticResource PrimaryButton}" Height="32" Padding="12,0" Click="BtnPripremi_Click"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="12" BorderBrush="#E2E8F0" BorderThickness="1">
            <DataGrid x:Name="DgStavke" AutoGenerateColumns="False" IsReadOnly="True"
                      GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="White" RowHeight="28" FontSize="12">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="JMBG" Binding="{Binding Jmbg}" Width="120"/>
                    <DataGridTextColumn Header="Zaposleni" Binding="{Binding ZaposleniIme}" Width="160" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="Nalog" Binding="{Binding BrojNaloga}" Width="110"/>
                    <DataGridTextColumn Header="Povratak" Binding="{Binding DatumPovratka}" Width="100"/>
                    <DataGridTextColumn Header="Dnevnica ukupno" Binding="{Binding UkupnoDnevnice, StringFormat=\{0:N2\}}" Width="120" ElementStyle="{StaticResource RightAlign}"/>
                    <DataGridTextColumn Header="Prekoračenje" Binding="{Binding PrekoracenjeDnevnice, StringFormat=\{0:N2\}}" Width="120" ElementStyle="{StaticResource RightAlign}" FontWeight="Bold"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="3" Background="#FFFBEB" CornerRadius="8" Padding="10" Margin="0,10,0,0" BorderBrush="#FDE68A" BorderThickness="1"
                x:Name="PanelNalazi" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Nalazi:" FontWeight="Bold" Margin="0,0,0,4"/>
                <ItemsControl x:Name="ListaNalaza">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,2"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="4" Margin="0,10,0,0">
            <TextBlock x:Name="TxtStatus" DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="#64748B"/>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                <Button Content="Zatvori" Style="{StaticResource SecondaryButton}" Height="36" Padding="14,0" Margin="0,0,8,0" Click="BtnZatvori_Click"/>
                <Button x:Name="BtnSacuvaj" Content="💾 Sačuvaj JSON za ERPiZarade" Style="{StaticResource PrimaryButton}" Height="36" Padding="14,0" IsEnabled="False" Click="BtnSacuvaj_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
