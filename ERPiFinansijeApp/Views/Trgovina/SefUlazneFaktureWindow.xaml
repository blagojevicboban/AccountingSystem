<Window x:Class="ERPiFinansijeApp.Views.Trgovina.SefUlazneFaktureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="📥 Preuzimanje Ulaznih e-Faktura sa SEF-a" Height="600" Width="900"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="📥 Ulazne e-Fakture Dobavljača sa SEF-a" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
            <TextBlock Text="Preuzimanje faktura iz mrežnog registra Ministarstva finansija." FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Filteri -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Preuzmi fakture od datuma:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                <DatePicker Grid.Column="1" x:Name="DpOdDatuma" Height="34" VerticalContentAlignment="Center"/>

                <Button Grid.Column="3" Content="🔄 Osveži / Preuzmi sa SEF-a" Style="{StaticResource ActionButtonStyle}" Height="34" Padding="16,0" Click="BtnOsvezi_Click"/>
            </Grid>
        </Border>

        <!-- DataGrid ulaznih e-faktura -->
        <DataGrid Grid.Row="2" x:Name="DgUlazneFakture" AutoGenerateColumns="False" IsReadOnly="True"
                  Background="{StaticResource SurfaceBrush}" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="SEF ID" Binding="{Binding PurchaseInvoiceId}" Width="100"/>
                <DataGridTextColumn Header="Broj fakture" Binding="{Binding InvoiceNumber}" Width="140"/>
                <DataGridTextColumn Header="Dobavljač" Binding="{Binding SupplierName}" Width="*"/>
                <DataGridTextColumn Header="PIB" Binding="{Binding SupplierPib}" Width="110"/>
                <DataGridTextColumn Header="Ukupan Iznos (RSD)" Binding="{Binding TotalAmount, StringFormat=N2}" Width="130" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Footer / Akcije -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <TextBlock x:Name="TxtStatus" Text="Spremno za preuzimanje." VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
            <Button Content="Zatvori" Width="100" Height="34" HorizontalAlignment="Right" Click="BtnZatvori_Click"/>
        </Grid>
    </Grid>
</Window>
