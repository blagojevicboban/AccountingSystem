<Window x:Class="ERPiFinansijeApp.Views.Trgovina.FiskalniRacunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🧾 e-Fiskalizacija (Izdavanje Fiskalnog Računa PFR)" Height="640" Width="820"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="🧾 Izdavanje Fiskalnog Računa (ESIR / PFR)" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
            <TextBlock Text="Slanje zahteva PFR servisu Poreske uprave RS i generisanje fiskalnog isečka sa QR kodom." FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Leva strana: Podaci i izbor plaćanja -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="💳 Način plaćanja" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,12"/>

                    <TextBlock Text="Izaberite sredstvo plaćanja:" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,6"/>
                    <RadioButton x:Name="RbGotovina" Content="💵 Gotovina (Cash)" IsChecked="True" Margin="0,0,0,8" FontWeight="SemiBold"/>
                    <RadioButton x:Name="RbKartica" Content="💳 Platna kartica (Card)" Margin="0,0,0,8" FontWeight="SemiBold"/>
                    <RadioButton x:Name="RbVirman" Content="🏦 Prenos na račun (WireTransfer)" Margin="0,0,0,16" FontWeight="SemiBold"/>

                    <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Ukupno za uplatu:" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock x:Name="TxtUkupnoZaUplatu" Text="0.00 RSD" FontSize="20" FontWeight="Bold" Foreground="#0284C7" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Button x:Name="BtnFiskalizuj" Content="⚡ Fiskalizuj račun" Height="40" Background="#0D9488" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnFiskalizuj_Click"/>
                </StackPanel>
            </Border>

            <!-- Desna strana: Fiskalni isečak (Journal & QR Code) -->
            <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="📄 Fiskalni Isečak (PFR Odgovor)" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,10"/>

                    <TextBox Grid.Row="1" x:Name="TxtFiskalniJournal" IsReadOnly="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" Background="#FAF9F6" Padding="10" Text="Čeka se fiskalizacija..."/>

                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <TextBlock Text="Verifikacioni URL / QR Kod Poreske Uprave RS:" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBox x:Name="TxtVerificationUrl" IsReadOnly="True" FontSize="11" FontFamily="Consolas" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <TextBlock x:Name="TxtStatus" Text="Spremno za fiskalizaciju." VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
            <Button Content="Zatvori" Width="100" Height="34" HorizontalAlignment="Right" Click="BtnZatvori_Click"/>
        </Grid>
    </Grid>
</Window>
