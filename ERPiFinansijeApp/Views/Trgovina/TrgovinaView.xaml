<UserControl x:Class="ERPiFinansijeApp.Views.Trgovina.TrgovinaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1200">
    <Grid>
        <TabControl x:Name="TabTrgovina" Background="Transparent" BorderThickness="0">

            <!-- ===================== PONUDE I PREDRAČUNI (PROFORME) ===================== -->
            <TabItem x:Name="TabPonude" Header="📜 Ponude &amp; Predračuni">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="200"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="16,12" Margin="0,0,0,16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <DockPanel LastChildFill="True">
                            <WrapPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,2,16,2">
                                <TextBlock Text="🔍 Pretraga:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0"/>
                                <TextBox x:Name="TxtPretragaPonuda" Height="34" Width="220" VerticalContentAlignment="Center" Padding="8,0" TextChanged="TxtPretragaPonuda_TextChanged"/>
                            </WrapPanel>
                            <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="BtnNovaPonuda" Content="➕ Nova ponuda / predračun" Style="{StaticResource ActionButtonStyle}" Margin="0,2,8,2" ToolTip="Kreiraj novu ponudu ili predračun (F2)" Click="BtnNovaPonuda_Click"/>
                                <Button x:Name="BtnIzmeniPonudu" Content="✏️ Izmeni" Style="{StaticResource ActionButtonStyle}" Background="#4B5563" Margin="0,2,8,2" ToolTip="Izmeni izabranu ponudu ili predračun" Click="BtnIzmeniPonudu_Click"/>
                                <Button x:Name="BtnObrisiPonudu" Content="🗑️ Obriši" Style="{StaticResource ActionButtonStyle}" Background="#EF4444" Margin="0,2,8,2" ToolTip="Obriši izabranu ponudu ili predračun" Click="BtnObrisiPonudu_Click"/>
                                <Button x:Name="BtnPretvoriURacun" Content="🚀 Pretvori u Fakturu &amp; SEF" Style="{StaticResource ActionButtonStyle}" Background="#2563EB" Margin="0,2,8,2" ToolTip="Pretvori ponudu u račun i pošalji na SEF portal" Click="BtnPretvoriURacun_Click"/>
                                <Button x:Name="BtnExportExcelPonude" Content="X" FontWeight="Bold" FontSize="20" Style="{StaticResource ActionButtonStyle}" Background="#059669" Width="36" Padding="0" ToolTip="Izvoz ponuda i predračuna u Excel" Margin="0,2,8,2" Click="BtnExportExcelPonude_Click"/>
                                <Button x:Name="BtnStampaPonuda" Content="🖨️" Style="{StaticResource ActionButtonStyle}" Background="#4F46E5" Width="36" Padding="0" ToolTip="Štampaj ponudu/predračun u PDF" Margin="0,2,0,2" Click="BtnStampaPonuda_Click"/>
                            </WrapPanel>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <DataGrid x:Name="DgPonude" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                  GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="Transparent" BorderThickness="0"
                                  SelectionChanged="DgPonude_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Broj dok." Binding="{Binding BrojDokumenta}" Width="120" FontWeight="Bold"/>
                                <DataGridTextColumn Header="Vrsta" Binding="{Binding VrstaDokumenta}" Width="100"/>
                                <DataGridTextColumn Header="Datum" Binding="{Binding Datum, StringFormat=\{0:dd.MM.yyyy\}}" Width="100"/>
                                <DataGridTextColumn Header="Rok važenja" Binding="{Binding RokVazenja, StringFormat=\{0:dd.MM.yyyy\}}" Width="100"/>
                                <DataGridTextColumn Header="Kupac / Partner" Binding="{Binding NazivPartnera}" Width="*"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="Ukupno Bruto" Binding="{Binding UkupnoBruto, StringFormat=\{0:N2\}}" Width="130" ElementStyle="{StaticResource NumericColumnElementStyle}" FontWeight="Bold"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" Background="Transparent"/>

                    <Border Grid.Row="3" Background="White" CornerRadius="8" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <DockPanel>
                            <TextBlock Text="📋 Stavke ponude / predračuna" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextBrush}" DockPanel.Dock="Top" Margin="0,0,0,8"/>
                            <DataGrid x:Name="DgPonudaStavke" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="Transparent" BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="R.br." Binding="{Binding RedniBroj}" Width="50"/>
                                    <DataGridTextColumn Header="Šifra" Binding="{Binding SifraArtikla}" Width="90"/>
                                    <DataGridTextColumn Header="Naziv artikla" Binding="{Binding NazivArtikla}" Width="*"/>
                                    <DataGridTextColumn Header="J.M." Binding="{Binding JedinicaMere}" Width="50"/>
                                    <DataGridTextColumn Header="Količina" Binding="{Binding Kolicina, StringFormat=\{0:N2\}}" Width="90" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                                    <DataGridTextColumn Header="Cena" Binding="{Binding Cena, StringFormat=\{0:N2\}}" Width="100" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                                    <DataGridTextColumn Header="Neto" Binding="{Binding IznosNeto, StringFormat=\{0:N2\}}" Width="110" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                                    <DataGridTextColumn Header="PDV (20%)" Binding="{Binding IznosPdv, StringFormat=\{0:N2\}}" Width="100" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                                    <DataGridTextColumn Header="Bruto" Binding="{Binding IznosBruto, StringFormat=\{0:N2\}}" Width="120" ElementStyle="{StaticResource NumericColumnElementStyle}" FontWeight="Bold"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ===================== NARUDŽBENICE DOBAVLJAČIMA ===================== -->
            <TabItem x:Name="TabNarudzbenice" Header="🛒 Narudžbenice Dobavljačima">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="200"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="16,12" Margin="0,0,0,16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <DockPanel LastChildFill="True">
                            <WrapPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,2,16,2">
                                <TextBlock Text="🔍 Pretraga:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0"/>
                                <TextBox x:Name="TxtPretragaNarudzbenice" Height="34" Width="220" VerticalContentAlignment="Center" Padding="8,0" TextChanged="TxtPretragaNarudzbenice_TextChanged"/>
                            </WrapPanel>
                            <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="BtnNovaNarudzbenica" Content="➕ Nova narudžbenica" Style="{StaticResource ActionButtonStyle}" Margin="0,2,8,2" ToolTip="Kreiraj novu narudžbenicu dobavljaču (F2)" Click="BtnNovaNarudzbenica_Click"/>
                                <Button x:Name="BtnIzmeniNarudzbenicu" Content="✏️ Izmeni" Style="{StaticResource ActionButtonStyle}" Background="#4B5563" Margin="0,2,8,2" ToolTip="Izmeni izabranu narudžbenicu" Click="BtnIzmeniNarudzbenicu_Click"/>
                                <Button x:Name="BtnObrisiNarudzbenicu" Content="🗑️ Obriši" Style="{StaticResource ActionButtonStyle}" Background="#EF4444" Margin="0,2,8,2" ToolTip="Obriši izabranu narudžbenicu" Click="BtnObrisiNarudzbenicu_Click"/>
                                <Button x:Name="BtnPretvoriUKalkulaciju" Content="📥 Pretvori u Kalkulaciju" Style="{StaticResource ActionButtonStyle}" Background="#10B981" Margin="0,2,8,2" ToolTip="Pretvori narudžbenicu u kalkulaciju ulaza robe" Click="BtnPretvoriUKalkulaciju_Click"/>
                                <Button x:Name="BtnExportExcelNarudzbenice" Content="X" FontWeight="Bold" FontSize="20" Style="{StaticResource ActionButtonStyle}" Background="#059669" Width="36" Padding="0" ToolTip="Izvoz narudžbenica u Excel" Margin="0,2,8,2" Click="BtnExportExcelNarudzbenice_Click"/>
                                <Button x:Name="BtnStampaNarudzbenica" Content="🖨️" Style="{StaticResource ActionButtonStyle}" Background="#4F46E5" Width="36" Padding="0" ToolTip="Štampaj narudžbenicu u PDF" Margin="0,2,0,2" Click="BtnStampaNarudzbenica_Click"/>
                            </WrapPanel>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <DataGrid x:Name="DgNarudzbenice" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                  GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="Transparent" BorderThickness="0"
                                  SelectionChanged="DgNarudzbenice_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Broj narudžb." Binding="{Binding BrojNarudzbenice}" Width="130" FontWeight="Bold"/>
                                <DataGridTextColumn Header="Datum" Binding="{Binding Datum, StringFormat=\{0:dd.MM.yyyy\}}" Width="100"/>
                                <DataGridTextColumn Header="Rok isporuke" Binding="{Binding RokIsporuke, StringFormat=\{0:dd.MM.yyyy\}}" Width="100"/>
                                <DataGridTextColumn Header="Dobavljač" Binding="{Binding NazivDobavljaca}" Width="*"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="Ukupno Naručeno" Binding="{Binding UkupnoBruto, StringFormat=\{0:N2\}}" Width="140" ElementStyle="{StaticResource NumericColumnElementStyle}" FontWeight="Bold"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" Background="Transparent"/>

                    <Border Grid.Row="3" Background="White" CornerRadius="8" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <DockPanel>
                            <TextBlock Text="📋 Naručeni artikli" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextBrush}" DockPanel.Dock="Top" Margin="0,0,0,8"/>
                            <DataGrid x:Name="DgNarudzbenicaStavke" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="Transparent" BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="R.br." Binding="{Binding RedniBroj}" Width="50"/>
                                    <DataGridTextColumn Header="Šifra" Binding="{Binding SifraArtikla}" Width="90"/>
                                    <DataGridTextColumn Header="Naziv artikla" Binding="{Binding NazivArtikla}" Width="*"/>
                                    <DataGridTextColumn Header="J.M." Binding="{Binding JedinicaMere}" Width="50"/>
                                    <DataGridTextColumn Header="Naručeno" Binding="{Binding KolicinaNarucena, StringFormat=\{0:N2\}}" Width="90" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                                    <DataGridTextColumn Header="Nabavna cena" Binding="{Binding Cena, StringFormat=\{0:N2\}}" Width="100" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                                    <DataGridTextColumn Header="Neto" Binding="{Binding IznosNeto, StringFormat=\{0:N2\}}" Width="110" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                                    <DataGridTextColumn Header="PDV (20%)" Binding="{Binding IznosPdv, StringFormat=\{0:N2\}}" Width="100" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                                    <DataGridTextColumn Header="Bruto" Binding="{Binding IznosBruto, StringFormat=\{0:N2\}}" Width="120" ElementStyle="{StaticResource NumericColumnElementStyle}" FontWeight="Bold"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ===================== ŠIFRARNIK RAČUNOPOLAGAČA (MAT1) ===================== -->
            <TabItem x:Name="TabRacunopolagaci" Header="🏢 Računopolagači">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="16,12" Margin="0,0,0,16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <DockPanel LastChildFill="True">
                            <WrapPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,2,16,2">
                                <TextBlock Text="🔍 Pretraga:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                                <TextBox x:Name="TxtPretragaRacunopol" Width="260" Height="34" VerticalContentAlignment="Center" Padding="8,0" TextChanged="TxtPretragaRacunopol_TextChanged"/>
                            </WrapPanel>
                            <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="BtnNoviRacunopol" Content="➕ Novi računopolagač" Style="{StaticResource ActionButtonStyle}" Margin="0,2,8,2" ToolTip="Dodaj novog računopolagača / magacin" Click="BtnNoviRacunopol_Click"/>
                                <Button x:Name="BtnIzmeniRacunopol" Content="✏️ Izmeni" Width="90" Height="34" Margin="0,2,8,2" ToolTip="Izmeni podatke o računopolagaču" Click="BtnIzmeniRacunopol_Click"/>
                                <Button x:Name="BtnBrisiRacunopol" Content="🗑️ Obriši" Width="90" Height="34" Background="#EF4444" Foreground="White" Margin="0,2,8,2" ToolTip="Obriši računopolagača" Click="BtnBrisiRacunopol_Click"/>
                                <Button x:Name="BtnStampaRacunopol" Content="🖨️" Style="{StaticResource ActionButtonStyle}" Width="36" Padding="0" ToolTip="Štampaj šifarnik računopolagača (PDF)" Margin="0,2,8,2" Click="BtnStampaRacunopol_Click"/>
                                <Button x:Name="BtnExportExcelRacunopol" Content="X" FontWeight="Bold" FontSize="20" Width="36" Height="34" Background="#059669" Foreground="White" ToolTip="Izvoz šifarnika računopolagača u Excel" Margin="0,2,0,2" Click="BtnExportExcelRacunopol_Click"/>
                            </WrapPanel>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <DataGrid x:Name="DgRacunopolagaci" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="Transparent" BorderThickness="0" MouseDoubleClick="DgRacunopolagaci_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Šifra" Binding="{Binding SifraMagacina}" Width="100"/>
                                <DataGridTextColumn Header="Naziv / Računopolagač" Binding="{Binding NazivMagacina}" Width="2*"/>
                                <DataGridTextColumn Header="Odgovorno lice" Binding="{Binding OdgovornoLice}" Width="1.5*"/>
                                <DataGridTextColumn Header="Vrsta magacina" Binding="{Binding VrstaMagacina}" Width="130"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ===================== ŠIFRARNIK ARTIKALA (MAT2) ===================== -->
            <TabItem x:Name="TabSifrarnikArtikala" Header="📦 Šifrarnik artikala">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="16,12" Margin="0,0,0,16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <DockPanel LastChildFill="True">
                            <WrapPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,2,16,2">
                                <TextBlock Text="🔍 Pretraga artikala:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                                <TextBox x:Name="TxtPretragaSifrarnikArtikala" Width="280" Height="34" VerticalContentAlignment="Center" Padding="8,0" TextChanged="TxtPretragaSifrarnikArtikala_TextChanged"/>
                            </WrapPanel>
                            <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="BtnNoviArtikal" Content="➕ Novi artikal" Style="{StaticResource ActionButtonStyle}" Margin="0,2,8,2" ToolTip="Dodaj novi artikal u šifrarnik (F2)" Click="BtnNoviArtikal_Click"/>
                                <Button x:Name="BtnIzmeniArtikal" Content="✏️ Izmeni" Width="90" Height="34" Margin="0,2,8,2" ToolTip="Izmeni izabrani artikal" Click="BtnIzmeniArtikal_Click"/>
                                <Button x:Name="BtnBrisiArtikal" Content="🗑️ Obriši" Width="90" Height="34" Background="#EF4444" Foreground="White" Margin="0,2,8,2" ToolTip="Obriši izabrani artikal" Click="BtnBrisiArtikal_Click"/>
                                <Button x:Name="BtnStampaSifrarnikaArtikala" Content="🖨️" Style="{StaticResource ActionButtonStyle}" Width="36" Padding="0" ToolTip="Štampaj šifrarnik artikala (PDF)" Margin="0,2,8,2" Click="BtnStampaSifrarnikaArtikala_Click"/>
                                <Button x:Name="BtnExportExcelArtikli" Content="X" FontWeight="Bold" FontSize="20" Width="36" Height="34" Background="#059669" Foreground="White" ToolTip="Izvoz šifrarnika artikala u Excel" Margin="0,2,0,2" Click="BtnExportExcelArtikli_Click"/>
                            </WrapPanel>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <DataGrid x:Name="DgSifrarnikArtikala" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="Transparent" BorderThickness="0" MouseDoubleClick="DgSifrarnikArtikala_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Šifra" Binding="{Binding SifraArtikla}" Width="90"/>
                                <DataGridTextColumn Header="Naziv artikla" Binding="{Binding Naziv}" Width="2*"/>
                                <DataGridTextColumn Header="J.M." Binding="{Binding JedinicaMere}" Width="60"/>
                                <DataGridTextColumn Header="Pakovanje" Binding="{Binding Pakovanje}" Width="100"/>
                                <DataGridTextColumn Header="Tar.broj" Binding="{Binding TarifniBroj}" Width="90"/>
                                <DataGridTextColumn Header="Nabavna cena" Binding="{Binding NabavnaCena, StringFormat=\{0:N2\}}" Width="110" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                                <DataGridTextColumn Header="Prodajna cena" Binding="{Binding ProdajnaCena, StringFormat=\{0:N2\}}" Width="110" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ===================== PORESKE TARIFE (MAT6 - tarifni brojevi) ===================== -->
            <TabItem x:Name="TabPoreskeTarife" Header="🏛️ Poreske tarife">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="16,12" Margin="0,0,0,16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <DockPanel LastChildFill="True">
                            <WrapPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,2,16,2">
                                <TextBlock Text="🔍 Pretraga:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                                <TextBox x:Name="TxtPretragaPoreskeTarife" Width="220" Height="34" VerticalContentAlignment="Center" Padding="8,0" TextChanged="TxtPretragaPoreskeTarife_TextChanged"/>
                            </WrapPanel>
                            <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="BtnNovaPoreskaTarifa" Content="➕ Nova tarifa" Style="{StaticResource ActionButtonStyle}" Margin="0,2,8,2" ToolTip="Dodaj novu poresku tarifu" Click="BtnNovaPoreskaTarifa_Click"/>
                                <Button x:Name="BtnIzmeniPoreskaTarifa" Content="✏️ Izmeni" Width="90" Height="34" Margin="0,2,8,2" ToolTip="Izmeni poresku tarifu" Click="BtnIzmeniPoreskaTarifa_Click"/>
                                <Button x:Name="BtnBrisiPoreskaTarifa" Content="🗑️ Obriši" Width="90" Height="34" Background="#EF4444" Foreground="White" Margin="0,2,8,2" ToolTip="Obriši poresku tarifu" Click="BtnBrisiPoreskaTarifa_Click"/>
                                <Button x:Name="BtnExportExcelTarife" Content="X" FontWeight="Bold" FontSize="20" Width="36" Height="34" Background="#059669" Foreground="White" ToolTip="Izvoz poreskih tarifa u Excel" Margin="0,2,8,2" Click="BtnExportExcelTarife_Click"/>
                                <Button x:Name="BtnStampajPoreskeTarife" Content="🖨️" Style="{StaticResource ActionButtonStyle}" Width="36" Padding="0" ToolTip="Štampaj poreske tarife (PDF)" Margin="0,2,0,2" Click="BtnStampajPoreskeTarife_Click"/>
                            </WrapPanel>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <DataGrid x:Name="DgPoreskeTarife" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="Transparent" BorderThickness="0" SelectionMode="Extended" MouseDoubleClick="DgPoreskeTarife_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tar. broj" Binding="{Binding TarifniBroj}" Width="100"/>
                                <DataGridTextColumn Header="Porez %" Binding="{Binding PorezProcenat, StringFormat=\{0:N2\}}" Width="100" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                                <DataGridTextColumn Header="Poseban porez %" Binding="{Binding PosebanPorezProcenat, StringFormat=\{0:N2\}}" Width="130" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                                <DataGridTextColumn Header="Porez u ceni" Binding="{Binding PorezUCeni}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ===================== ZADUŽENJA (MAT4 - ZADUZ.DBF) ===================== -->
            <TabItem x:Name="TabZaduzenja" Header="📥 Zaduženja">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="200"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="16,12" Margin="0,0,0,16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <DockPanel LastChildFill="True">
                            <WrapPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,2,16,2">
                                <TextBlock Text="🔍 Pretraga zaduženja:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                                <TextBox x:Name="TxtPretragaZaduzenja" Width="220" Height="34" VerticalContentAlignment="Center" Padding="8,0" TextChanged="TxtPretragaZaduzenja_TextChanged" Margin="0,2,16,2"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,0,2">
                                    <RadioButton x:Name="RbSviZaduzenja" Content="Svi" GroupName="ZaduzenjaStatusFilter" VerticalAlignment="Center" Margin="0,0,8,0" Checked="Filter_Zaduzenja_Changed"/>
                                    <RadioButton x:Name="RbProknjizeniZaduzenja" Content="Proknjiženi" GroupName="ZaduzenjaStatusFilter" VerticalAlignment="Center" Margin="0,0,8,0" Checked="Filter_Zaduzenja_Changed"/>
                                    <RadioButton x:Name="RbNeproknjizeniZaduzenja" Content="Neproknjiženi" GroupName="ZaduzenjaStatusFilter" VerticalAlignment="Center" Checked="Filter_Zaduzenja_Changed"/>
                                </StackPanel>
                            </WrapPanel>
                            <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="BtnNovoZaduzenje" Content="➕ Novo zaduženje" Style="{StaticResource ActionButtonStyle}" Margin="0,2,8,2" ToolTip="Unos novog naloga zaduženja magacina (F2)" Click="BtnNovoZaduzenje_Click"/>
