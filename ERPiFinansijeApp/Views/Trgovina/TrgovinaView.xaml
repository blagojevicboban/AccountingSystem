                                <TextBox x:Name="TxtPretragaRacuna" Width="180" Height="34" VerticalContentAlignment="Center" Padding="8,0" TextChanged="TxtPretragaRacuna_TextChanged" Margin="0,2,16,2"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,0,2">
                                    <RadioButton x:Name="RbSviRacuni" Content="Svi" GroupName="RacuniStatusFilter" VerticalAlignment="Center" Margin="0,0,8,0" Checked="Filter_Racuni_Changed"/>
                                    <RadioButton x:Name="RbProknjizeniRacuni" Content="Proknjiženi" GroupName="RacuniStatusFilter" VerticalAlignment="Center" Margin="0,0,8,0" Checked="Filter_Racuni_Changed"/>
                                    <RadioButton x:Name="RbNeproknjizeniRacuni" Content="Neproknjiženi" GroupName="RacuniStatusFilter" VerticalAlignment="Center" Margin="0,0,8,0" Checked="Filter_Racuni_Changed"/>
                                    <RadioButton x:Name="RbPredracuniRacuni" Content="Predračuni" GroupName="RacuniStatusFilter" VerticalAlignment="Center" Checked="Filter_Racuni_Changed"/>
                                </StackPanel>
                            </WrapPanel>
                            <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="BtnNoviRacun" Content="➕ Novi račun" Style="{StaticResource ActionButtonStyle}" Margin="0,2,6,2" ToolTip="Unos novog računa / otpremnice (F2)" Click="BtnNoviRacun_Click"/>
                                <Button x:Name="BtnIzmeniRacun" Content="✏️ Izmeni" Style="{StaticResource ActionButtonStyle}" Background="#4B5563" Margin="0,2,6,2" ToolTip="Izmeni izabrani račun / otpremnicu" Click="BtnIzmeniRacun_Click"/>
                                <Button x:Name="BtnKnjiziRacun" Content="✅ Proknjiži" Style="{StaticResource ActionButtonStyle}" Background="#10B981" Margin="0,2,6,2" ToolTip="Proknjiži izabrani račun / otpremnicu" Click="BtnKnjiziRacun_Click"/>
                                <Button x:Name="BtnMasovnoKnjizenjeRacuna" Content="⚡ Masovno knjiženje" Style="{StaticResource ActionButtonStyle}" Background="#8B5CF6" Margin="0,2,6,2" ToolTip="Masovno proknjiži sve neproknjižene račune" Click="BtnMasovnoKnjizenjeRacuna_Click"/>
                                <Button x:Name="BtnPretvoriPredracun" Content="🔁" Style="{StaticResource ActionButtonStyle}" Background="#D97706" Width="36" Padding="0" ToolTip="Pretvori predračun u račun" Margin="0,2,6,2" Click="BtnPretvoriPredracun_Click"/>
                                <Button x:Name="BtnPosaljiNaSef" Content="📤 Pošalji na SEF" Style="{StaticResource ActionButtonStyle}" Background="#0284C7" Margin="0,2,6,2" ToolTip="Pošalji e-fakturu na SEF portal" Click="BtnPosaljiNaSef_Click"/>
                                <Button x:Name="BtnSacuvajUblXml" Content="📄 UBL XML" Style="{StaticResource ActionButtonStyle}" Background="#334155" Margin="0,2,6,2" ToolTip="Sačuvaj UBL 2.1 XML fajl e-fakture" Click="BtnSacuvajUblXml_Click"/>
                                <Button x:Name="BtnFiskalizujPfr" Content="🧾 Fiskalizuj (PFR)" Style="{StaticResource ActionButtonStyle}" Background="#0D9488" Margin="0,2,6,2" ToolTip="Izdavanje fiskalnog računa preko PFR-a" Click="BtnFiskalizujPfr_Click"/>
                                <Button x:Name="BtnPreuzmiUlazneSef" Content="📥 Ulazne SEF" Style="{StaticResource ActionButtonStyle}" Background="#0D9488" Margin="0,2,6,2" ToolTip="Preuzmi ulazne e-fakture sa SEF-a" Click="BtnPreuzmiUlazneSef_Click"/>
                                <Button x:Name="BtnExportExcelRacuni" Content="X" FontWeight="Bold" FontSize="20" Style="{StaticResource ActionButtonStyle}" Background="#059669" Width="36" Padding="0" ToolTip="Izvoz računa u Excel" Margin="0,2,6,2" Click="BtnExportExcelRacuni_Click"/>
                                <Button x:Name="BtnStampajRacun" Content="🖨️" Style="{StaticResource ActionButtonStyle}" Background="#2563EB" Width="36" Padding="0" ToolTip="Štampaj Račun (PDF)" Margin="0,2,0,2" Click="BtnStampajRacun_Click"/>
                            </WrapPanel>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <DockPanel>
                            <TextBlock Text="📜 Izlazi robe - Računi / Otpremnice" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextBrush}" DockPanel.Dock="Top" Margin="0,0,0,12"/>
                            <DataGrid x:Name="DgRacuni" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="Transparent" BorderThickness="0"
                                      SelectionChanged="DgRacuni_SelectionChanged" MouseDoubleClick="DgRacuni_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Tip" Binding="{Binding TipDokumenta}" Width="85"/>
                                    <DataGridTextColumn Header="Br. računa" Binding="{Binding BrojRacuna}" SortMemberPath="BrojRacuna" Width="110"/>
                                    <DataGridTextColumn Header="Br. otpremnice" Binding="{Binding BrojOtpremnice}" Width="110"/>
                                    <DataGridTextColumn Header="Datum" Binding="{Binding DatumRacuna, StringFormat=\{0:dd.MM.yyyy\}}" Width="95"/>
                                    <DataGridTextColumn Header="Kupac / Konto" Binding="{Binding KontoKupca}" Width="*"/>
                                    <DataGridTextColumn Header="SEF Status" Binding="{Binding SefStatus}" Width="110"/>
                                    <DataGridTextColumn Header="Fiskalni Broj" Binding="{Binding FiskalniBroj}" Width="140"/>
                                    <DataGridTextColumn Header="Rok (dana)" Binding="{Binding RokPlacanjaDana}" Width="80"/>
                                    <DataGridTextColumn Header="Bez PDV" Binding="{Binding IznosBezPdv, StringFormat=\{0:N2\}}" Width="120" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                                    <DataGridTextColumn Header="PDV" Binding="{Binding PdvIznos, StringFormat=\{0:N2\}}" Width="100" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                                    <DataGridTextColumn Header="Za uplatu" Binding="{Binding UkupanIznos, StringFormat=\{0:N2\}}" Width="130" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                                    <DataGridTextColumn Header="Proknjiženo" Binding="{Binding IsKnjizen}" Width="90"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" Background="Transparent"/>

                    <Border Grid.Row="3" Background="White" CornerRadius="8" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <DockPanel>
                            <TextBlock Text="📋 Stavke izabranog računa - otpremnice" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextBrush}" DockPanel.Dock="Top" Margin="0,0,0,8"/>
                            <DataGrid x:Name="DgRacunStavke" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="Transparent" BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="R.br." Binding="{Binding RedniBroj}" Width="50"/>
                                    <DataGridTextColumn Header="Šifra" Binding="{Binding SifraArtikla}" Width="100"/>
                                    <DataGridTextColumn Header="Naziv artikla" Binding="{Binding NazivArtikla}" Width="*"/>
                                    <DataGridTextColumn Header="Količina" Binding="{Binding Kolicina, StringFormat=\{0:N2\}}" Width="90" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                                    <DataGridTextColumn Header="Prod. cena" Binding="{Binding Cena, StringFormat=\{0:N2\}}" Width="100" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                                    <DataGridTextColumn Header="Rabat %" Binding="{Binding RabatProcenat, StringFormat=\{0:N0\}}" Width="70" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                                    <DataGridTextColumn Header="PDV %" Binding="{Binding PdvProcenat, StringFormat=\{0:N0\}}" Width="65" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                                    <DataGridTextColumn Header="Bez PDV" Binding="{Binding IznosBezPdv, StringFormat=\{0:N2\}}" Width="110" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                                    <DataGridTextColumn Header="Ukupno" Binding="{Binding UkupanIznos, StringFormat=\{0:N2\}}" Width="120" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ===================== NIVELACIJE CENA (MAT6) ===================== -->
            <TabItem x:Name="TabNivelacije" Header="🏷️ Nivelacije cena">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="200"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="16,12" Margin="0,0,0,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <DockPanel LastChildFill="True">
                            <WrapPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,2,16,2">
                                <TextBlock Text="🔍 Pretraga nivelacija:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                                <TextBox x:Name="TxtPretragaNivelacija" Width="180" Height="34" VerticalContentAlignment="Center" Padding="8,0" TextChanged="TxtPretragaNivelacija_TextChanged" Margin="0,2,16,2"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,0,2">
                                    <RadioButton x:Name="RbSviNivelacije" Content="Svi" GroupName="NivelacijeStatusFilter" VerticalAlignment="Center" Margin="0,0,8,0" Checked="Filter_Nivelacije_Changed"/>
                                    <RadioButton x:Name="RbProknjizeniNivelacije" Content="Proknjiženi" GroupName="NivelacijeStatusFilter" VerticalAlignment="Center" Margin="0,0,8,0" Checked="Filter_Nivelacije_Changed"/>
                                    <RadioButton x:Name="RbNeproknjizeniNivelacije" Content="Neproknjiženi" GroupName="NivelacijeStatusFilter" VerticalAlignment="Center" Checked="Filter_Nivelacije_Changed"/>
                                </StackPanel>
                            </WrapPanel>
                            <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="BtnGenerisiNivelaciju" Content="⚙️ Svođenje cena" Style="{StaticResource ActionButtonStyle}" Background="#D97706" Margin="0,2,6,2" ToolTip="Automatska nivelacija na zadate prodajne cene" Click="BtnGenerisiNivelaciju_Click"/>
                                <Button x:Name="BtnNovaNivelacija" Content="➕ Nova nivelacija" Style="{StaticResource ActionButtonStyle}" Margin="0,2,6,2" ToolTip="Unos novog zapisnika o nivelaciji cena (F2)" Click="BtnNovaNivelacija_Click"/>
                                <Button x:Name="BtnIzmeniNivelaciju" Content="✏️ Izmeni" Style="{StaticResource ActionButtonStyle}" Background="#4B5563" Margin="0,2,6,2" ToolTip="Izmeni zapisnik o nivelaciji" Click="BtnIzmeniNivelaciju_Click"/>
                                <Button x:Name="BtnKnjiziNivelaciju" Content="✅ Proknjiži" Style="{StaticResource ActionButtonStyle}" Background="#10B981" Margin="0,2,6,2" ToolTip="Proknjiži nivelaciju cena" Click="BtnKnjiziNivelaciju_Click"/>
                                <Button x:Name="BtnMasovnoKnjizenjeNivelacija" Content="⚡ Masovno knjiženje" Style="{StaticResource ActionButtonStyle}" Background="#8B5CF6" Margin="0,2,6,2" ToolTip="Masovno proknjiži sve neproknjižene nivelacije" Click="BtnMasovnoKnjizenjeNivelacija_Click"/>
                                <Button x:Name="BtnExportExcelNivelacije" Content="X" FontWeight="Bold" FontSize="20" Style="{StaticResource ActionButtonStyle}" Background="#059669" Width="36" Padding="0" ToolTip="Izvoz nivelacija u Excel" Margin="0,2,6,2" Click="BtnExportExcelNivelacije_Click"/>
                                <Button x:Name="BtnStampajNivelaciju" Content="🖨️" Style="{StaticResource ActionButtonStyle}" Background="#2563EB" Width="36" Padding="0" ToolTip="Štampaj Zapisnik (PDF)" Margin="0,2,0,2" Click="BtnStampajNivelaciju_Click"/>
                            </WrapPanel>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <DockPanel>
                            <TextBlock Text="🏷️ Nivelacije prodajnih cena i promene" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextBrush}" DockPanel.Dock="Top" Margin="0,0,0,12"/>
                            <DataGrid x:Name="DgNivelacije" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="Transparent" BorderThickness="0"
                                      SelectionChanged="DgNivelacije_SelectionChanged" MouseDoubleClick="DgNivelacije_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Br. nivelacije" Binding="{Binding BrojNivelacije}" Width="130"/>
                                    <DataGridTextColumn Header="Datum" Binding="{Binding DatumNivelacije, StringFormat=\{0:dd.MM.yyyy\}}" Width="100"/>
                                    <DataGridTextColumn Header="Magacin" Binding="{Binding SifraMagacina}" Width="100"/>
                                    <DataGridTextColumn Header="Opis / Napomena" Binding="{Binding Opis}" Width="*"/>
                                    <DataGridTextColumn Header="Ukupna razlika" Binding="{Binding UkupnoRazlika, StringFormat=\{0:N2\}}" Width="140" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                                    <DataGridTextColumn Header="Proknjiženo" Binding="{Binding IsKnjizen}" Width="95"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" Background="Transparent"/>

                    <Border Grid.Row="3" Background="White" CornerRadius="8" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <DockPanel>
                            <TextBlock Text="📋 Stavke izabranog zapisnika o nivelaciji cena" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextBrush}" DockPanel.Dock="Top" Margin="0,0,0,8"/>
                            <DataGrid x:Name="DgNivelacijaStavke" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="Transparent" BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="R.br." Binding="{Binding RedniBroj}" Width="50"/>
                                    <DataGridTextColumn Header="Šifra" Binding="{Binding SifraArtikla}" Width="100"/>
                                    <DataGridTextColumn Header="Naziv artikla" Binding="{Binding NazivArtikla}" Width="*"/>
                                    <DataGridTextColumn Header="J.M." Binding="{Binding JedinicaMere}" Width="50"/>
                                    <DataGridTextColumn Header="Zaliha" Binding="{Binding KolicinaZaliha, StringFormat=\{0:N2\}}" Width="90" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                                    <DataGridTextColumn Header="Stara cena" Binding="{Binding StaraCena, StringFormat=\{0:N2\}}" Width="100" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                                    <DataGridTextColumn Header="Nova cena" Binding="{Binding NovaCena, StringFormat=\{0:N2\}}" Width="100" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                                    <DataGridTextColumn Header="Razl. / jed." Binding="{Binding RazlikaPoJedinici, StringFormat=\{0:N2\}}" Width="90" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                                    <DataGridTextColumn Header="Uk. Razlika" Binding="{Binding UkupnaRazlika, StringFormat=\{0:N2\}}" Width="120" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ===================== ROBNE KARTICE ===================== -->
            <TabItem x:Name="TabRobneKartice" Header="📇 Robne kartice">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="16" Margin="0,0,16,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <DockPanel>
                            <TextBlock Text="Magacin / Računopolagač" FontSize="12" Foreground="{StaticResource TextMutedBrush}" DockPanel.Dock="Top" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmbMagacinRobno" DockPanel.Dock="Top" Height="34" Margin="0,0,0,12"
                                      DisplayMemberPath="Prikaz" SelectionChanged="CmbMagacinRobno_SelectionChanged"/>

                            <TextBlock Text="📦 Artikli" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextBrush}" DockPanel.Dock="Top" Margin="0,0,0,12"/>
                            <TextBox x:Name="TxtPretragaArtiklaRobno" DockPanel.Dock="Top" Height="34" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,8" ToolTip="Pretraga po šifri ili nazivu artikla" TextChanged="TxtPretragaArtiklaRobno_TextChanged"/>
                            <CheckBox x:Name="ChkSamoSaKarticom" Content="Samo artikli sa karticom" DockPanel.Dock="Top" Margin="0,0,0,12" Checked="ChkSamoSaKarticom_Changed" Unchecked="ChkSamoSaKarticom_Changed"/>
                            <DataGrid x:Name="LstArtikliRobno" AutoGenerateColumns="False" SelectionMode="Single" SelectionUnit="FullRow" GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="Transparent" BorderThickness="0" ToolTip="Desni klik za dodatne opcije" SelectionChanged="LstArtikliRobno_SelectionChanged" PreviewMouseRightButtonDown="LstArtikliRobno_PreviewMouseRightButtonDown">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="🖨️ Štampaj karticu" Click="CtxStampajRobnuKarticu_Click"/>
                                        <MenuItem Header="📊 Izvoz u Excel" Click="CtxExportExcelRobnaKartica_Click"/>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="30">
                                        <DataGridCheckBoxColumn.Header>
                                            <CheckBox x:Name="ChkSviArtikliRobno" IsThreeState="True" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Checked="ChkSviArtikliRobno_Checked" Unchecked="ChkSviArtikliRobno_Unchecked"/>
                                        </DataGridCheckBoxColumn.Header>
                                        <DataGridCheckBoxColumn.ElementStyle>
                                            <Style TargetType="CheckBox">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridCheckBoxColumn.ElementStyle>
                                    </DataGridCheckBoxColumn>
                                    <DataGridTextColumn Header="Šifra" Binding="{Binding SifraArtikla}" Width="90" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Naziv" Binding="{Binding Naziv}" Width="*" IsReadOnly="True"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="16,12" Margin="0,0,0,16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <DockPanel LastChildFill="True">
                                <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button x:Name="BtnStampajRobnaKartica" Content="🖨️" Style="{StaticResource ActionButtonStyle}" Width="36" Padding="0" ToolTip="Štampaj karticu/e (PDF)" Margin="0,2,8,2" Click="BtnStampajRobnaKartica_Click"/>
                                    <Button x:Name="BtnExportExcelRobnaKartica" Content="X" FontWeight="Bold" FontSize="20" Style="{StaticResource ActionButtonStyle}" Background="#059669" Width="36" Padding="0" ToolTip="Izvoz u Excel" Margin="0,2,0,2" Click="BtnExportExcelRobnaKartica_Click"/>
                                </WrapPanel>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock x:Name="TxtNaslovArtiklaRobno" Text="Izaberite magacin i artikal sa leve strane" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="TxtStanjeArtiklaRobno" Text=" " FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <DataGrid x:Name="DgRobnaKartica" Grid.Row="0" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="Transparent" BorderThickness="0" ToolTip="Dupli klik na stavku prikazuje izvorni dokument" MouseDoubleClick="DgRobnaKartica_MouseDoubleClick">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Datum" Binding="{Binding DatumPromene, StringFormat=\{0:dd.MM.yyyy\}}" Width="100"/>
                                        <DataGridTextColumn Header="Opis promene" Binding="{Binding OpisPromene}" Width="160"/>
                                        <DataGridTextColumn Header="Ulaz" Binding="{Binding Ulaz, StringFormat=\{0:N2\}}" Width="90" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                                        <DataGridTextColumn Header="Izlaz" Binding="{Binding Izlaz, StringFormat=\{0:N2\}}" Width="90" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                                        <DataGridTextColumn Header="Stanje" Binding="{Binding Stanje, StringFormat=\{0:N2\}}" Width="90" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                                        <DataGridTextColumn Header="Cena" Binding="{Binding Cena, StringFormat=\{0:N2\}}" Width="100" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                                        <DataGridTextColumn Header="Duguje" Binding="{Binding Duguje, StringFormat=\{0:N2\}}" Width="110" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                                        <DataGridTextColumn Header="Potražuje" Binding="{Binding Potrazuje, StringFormat=\{0:N2\}}" Width="110" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                                        <DataGridTextColumn Header="Saldo" Binding="{Binding Saldo, StringFormat=\{0:N2\}}" Width="120" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                                        <DataGridTextColumn Header="Pros. cena" Binding="{Binding CenaIzlaz, StringFormat=\{0:N2\}}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Border Grid.Row="1" Background="#EFF6FF" CornerRadius="6" Padding="12,10" Margin="0,8,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="1" Text="UKUPNO:" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="TxtSumaUlazRobno" Grid.Column="2" Text="0,00" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="TxtSumaIzlazRobno" Grid.Column="3" Text="0,00" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="TxtSumaDugujeRobno" Grid.Column="6" Text="0,00" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="TxtSumaPotrazujeRobno" Grid.Column="7" Text="0,00" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="TxtSumaSaldoRobno" Grid.Column="8" Text="0,00" FontWeight="Bold" FontSize="15" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#2563EB"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ===================== ROBNI BRUTO BILANS (MAT6) ===================== -->
            <TabItem x:Name="TabRobniBrutoBilans" Header="📊 Robni Bruto bilans">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="16,12" Margin="0,0,0,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <DockPanel LastChildFill="True">
                            <WrapPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,2,16,2">
                                <TextBlock Text="Magacin:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                <ComboBox x:Name="CmbMagacinBruto" Width="180" Height="34" DisplayMemberPath="Prikaz" SelectedValuePath="MagacinId" SelectionChanged="CmbMagacinBruto_SelectionChanged" Margin="0,2,16,2"/>

                                <TextBlock Text="Do datuma:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                <DatePicker x:Name="DpDoDatumaBruto" Width="130" Height="34" SelectedDateChanged="DpDoDatumaBruto_SelectedDateChanged" Margin="0,2,16,2"/>

                                <TextBlock Text="🔍 Pretraga:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                <TextBox x:Name="TxtPretragaBruto" Width="180" Height="34" VerticalContentAlignment="Center" Padding="8,0" TextChanged="TxtPretragaBruto_TextChanged" Margin="0,2,0,2"/>
                            </WrapPanel>
                            <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="BtnOsveziBruto" Content="🔄 Osveži bilans" Style="{StaticResource ActionButtonStyle}" Background="#10B981" Margin="0,2,8,2" ToolTip="Preračunaj i osveži robni bruto bilans" Click="BtnOsveziBruto_Click"/>
                                <Button x:Name="BtnStampajRasporedArtikala" Content="🖨️" Style="{StaticResource ActionButtonStyle}" Background="#4B5563" Width="36" Padding="0" ToolTip="Raspored artikala po magacinima (PDF)" Margin="0,2,8,2" Click="BtnStampajRasporedArtikala_Click"/>
                                <Button x:Name="BtnStampajStanjePoArtiklima" Content="🖨️" Style="{StaticResource ActionButtonStyle}" Background="#4B5563" Width="36" Padding="0" ToolTip="Stanje zaliha po artiklima (PDF)" Margin="0,2,8,2" Click="BtnStampajStanjePoArtiklima_Click"/>
                                <Button x:Name="BtnExportExcelRobniBruto" Content="X" FontWeight="Bold" FontSize="20" Style="{StaticResource ActionButtonStyle}" Background="#059669" Width="36" Padding="0" ToolTip="Izvoz robnog bruto bilansa u Excel" Margin="0,2,8,2" Click="BtnExportExcelRobniBruto_Click"/>
                                <Button x:Name="BtnStampajRobniBruto" Content="🖨️" Style="{StaticResource ActionButtonStyle}" Background="#2563EB" Width="36" Padding="0" ToolTip="Štampaj robni bruto bilans (PDF)" Margin="0,2,0,2" Click="BtnStampajRobniBruto_Click"/>
                            </WrapPanel>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <DockPanel>
                            <TextBlock Text="📊 Robni / Materijalni Bruto Bilans po artiklima i magacinima" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextBrush}" DockPanel.Dock="Top" Margin="0,0,0,12"/>
                            <DataGrid x:Name="DgRobniBrutoBilans" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="Transparent" BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Magacin" Binding="{Binding SifraMagacina}" Width="80"/>
                                    <DataGridTextColumn Header="Šifra" Binding="{Binding SifraArtikla}" Width="100"/>
                                    <DataGridTextColumn Header="Naziv artikla / robe" Binding="{Binding NazivArtikla}" Width="*"/>
                                    <DataGridTextColumn Header="J.M." Binding="{Binding JedinicaMere}" Width="50"/>
                                    <DataGridTextColumn Header="Cena" Binding="{Binding Cena, StringFormat=\{0:N2\}}" Width="90" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                                    <DataGridTextColumn Header="Ulaz kol." Binding="{Binding UlazKolicina, StringFormat=\{0:N2\}}" Width="90" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                                    <DataGridTextColumn Header="Duguje (Ulaz RSD)" Binding="{Binding UlazVrednost, StringFormat=\{0:N2\}}" Width="120" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                                    <DataGridTextColumn Header="Izlaz kol." Binding="{Binding IzlazKolicina, StringFormat=\{0:N2\}}" Width="90" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                                    <DataGridTextColumn Header="Potražuje (Izlaz RSD)" Binding="{Binding IzlazVrednost, StringFormat=\{0:N2\}}" Width="120" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                                    <DataGridTextColumn Header="Stanje kol." Binding="{Binding SaldoKolicinski, StringFormat=\{0:N2\}}" Width="90" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                                    <DataGridTextColumn Header="Saldo zaliha (RSD)" Binding="{Binding SaldoVrednosni, StringFormat=\{0:N2\}}" Width="130" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="16,10" Margin="0,12,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock x:Name="TxtUkupnoDugujeBruto" Text="Ukupno Duguje: 0,00 RSD" FontSize="13" FontWeight="Bold" Foreground="#059669" Margin="0,0,24,0"/>
                            <TextBlock x:Name="TxtUkupnoPotrazujeBruto" Text="Ukupno Potražuje: 0,00 RSD" FontSize="13" FontWeight="Bold" Foreground="#DC2626" Margin="0,0,24,0"/>
                            <TextBlock x:Name="TxtUkupnoSaldoBruto" Text="Saldo Zaliha: 0,00 RSD" FontSize="14" FontWeight="Bold" Foreground="#2563EB"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
