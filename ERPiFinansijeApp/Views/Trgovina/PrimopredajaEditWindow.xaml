<Window x:Class="ERPiFinansijeApp.Views.Trgovina.PrimopredajaEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nalog za primopredaju robe" Height="620" Width="840"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource BackgroundBrush}" KeyDown="Window_KeyDown">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TxtNaslov" Text="🔄 Nalog za primopredaju robe" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Grid.Row="0" Margin="0,0,0,16"/>

        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Broj naloga *" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBox x:Name="TxtBrojNaloga" Grid.Column="1" Height="34" VerticalContentAlignment="Center" Padding="8,0"/>

                <TextBlock Text="Datum naloga *" Grid.Column="3" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <DatePicker x:Name="DpDatum" Grid.Column="4" Height="34" VerticalContentAlignment="Center"/>

                <TextBlock Text="Magacin koji dajе *" Grid.Row="2" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <ComboBox x:Name="CmbMagacinDaje" Grid.Row="2" Grid.Column="1" Height="34" DisplayMemberPath="Prikaz" VerticalContentAlignment="Center"/>

                <TextBlock Text="Magacin koji prima *" Grid.Row="2" Grid.Column="3" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <ComboBox x:Name="CmbMagacinPrima" Grid.Row="2" Grid.Column="4" Height="34" DisplayMemberPath="Prikaz" VerticalContentAlignment="Center"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="📋 Stavke primopredaje" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <Button x:Name="BtnDodajStavku" Content="➕ Dodaj stavku" Style="{StaticResource ActionButtonStyle}" Click="BtnDodajStavku_Click"/>
                </StackPanel>

                <DataGrid x:Name="DgStavke" AutoGenerateColumns="False" CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="Transparent" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="R.br." Binding="{Binding RedniBroj}" Width="50" IsReadOnly="True"/>
                        <DataGridComboBoxColumn x:Name="ColArtikal" Header="Artikal *" Width="2.5*"/>
                        <DataGridTextColumn Header="Količina *" Binding="{Binding Kolicina, StringFormat=\{0:N2\}}" Width="100"/>
                        <DataGridTextColumn Header="Cena" Binding="{Binding Cena, StringFormat=\{0:N2\}}" Width="110"/>
                        <DataGridTextColumn Header="Iznos" Binding="{Binding Iznos, StringFormat=\{0:N2\}}" Width="120" IsReadOnly="True"/>
                        <DataGridTemplateColumn Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="🗑️" Width="30" Height="26" Background="#EF4444" Foreground="White" Click="BtnUkloniStavku_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="BtnOtkazi" Content="Odustani" Width="100" Height="36" Margin="0,0,10,0" Click="BtnOtkazi_Click"/>
            <Button x:Name="BtnSacuvaj" Content="💾 Sačuvaj nalog" Width="130" Height="36" Style="{StaticResource ActionButtonStyle}" Click="BtnSacuvaj_Click"/>
        </StackPanel>
    </Grid>
</Window>
