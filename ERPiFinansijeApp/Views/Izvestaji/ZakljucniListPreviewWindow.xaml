<Window x:Class="ERPiFinansijeApp.Views.Izvestaji.ZakljucniListPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:ERPiFinansijeData.Services;assembly=ERPiFinansijeData"
        Title="Zaključni list — pregled" Height="750" Width="1350"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="16,12" Margin="0,0,0,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <DockPanel>
                <Button x:Name="BtnExportExcelZakljucniList" DockPanel.Dock="Right" Content="X" FontWeight="Bold" FontSize="20" Style="{StaticResource ActionButtonStyle}" Background="#059669" Width="36" Padding="0" ToolTip="Izvoz u Excel" VerticalAlignment="Center" Click="BtnExportExcelZakljucniList_Click"/>
                <StackPanel>
                    <TextBlock x:Name="TxtNaslov" Text="ZAKLJUČNI LIST" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock x:Name="TxtPodnaslov" Text="" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <DockPanel>
                <!-- Summary bar for all 8 columns at bottom -->
                <Border DockPanel.Dock="Bottom" Margin="0,12,0,0" Padding="12,8" CornerRadius="8" Background="#F1F5F9">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="UKUPNO:" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal" Margin="0,2,16,2">
                                <TextBlock Text="Poč. Dug: " FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock x:Name="TxtPocDug" Text="0,00" FontWeight="Bold" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2,16,2">
                                <TextBlock Text="Poč. Pot: " FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock x:Name="TxtPocPot" Text="0,00" FontWeight="Bold" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2,16,2">
                                <TextBlock Text="Prom. Dug: " FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock x:Name="TxtPromDug" Text="0,00" FontWeight="Bold" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2,16,2">
                                <TextBlock Text="Prom. Pot: " FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock x:Name="TxtPromPot" Text="0,00" FontWeight="Bold" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2,16,2">
                                <TextBlock Text="Uk. Dug: " FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock x:Name="TxtUkDug" Text="0,00" FontWeight="Bold" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2,16,2">
                                <TextBlock Text="Uk. Pot: " FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock x:Name="TxtUkPot" Text="0,00" FontWeight="Bold" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2,16,2">
                                <TextBlock Text="Sal. Dug: " FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock x:Name="TxtSalDug" Text="0,00" FontWeight="Bold" Foreground="#059669" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                <TextBlock Text="Sal. Pot: " FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock x:Name="TxtSalPot" Text="0,00" FontWeight="Bold" Foreground="#059669" FontSize="11"/>
                            </StackPanel>
                        </WrapPanel>
                    </Grid>
                </Border>

                <DataGrid x:Name="DgZakljucniList" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="Transparent" BorderThickness="0" FontSize="12">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Tip}" Value="{x:Static svc:BrutoBilansRedTip.KlasaTotal}">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Background" Value="#E2E8F0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Konto" Binding="{Binding BrojKonta}" Width="55"/>
                        <DataGridTextColumn Header="Naziv konta" Binding="{Binding NazivKonta}" Width="*"/>
                        <DataGridTextColumn Header="Početno duguje" Binding="{Binding PocetnoDuguje, StringFormat=\{0:N2\}}" Width="120" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                        <DataGridTextColumn Header="Početno potražuje" Binding="{Binding PocetnoPotrazuje, StringFormat=\{0:N2\}}" Width="120" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                        <DataGridTextColumn Header="Promet duguje" Binding="{Binding PrometDuguje, StringFormat=\{0:N2\}}" Width="120" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                        <DataGridTextColumn Header="Promet potražuje" Binding="{Binding PrometPotrazuje, StringFormat=\{0:N2\}}" Width="120" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                        <DataGridTextColumn Header="Ukupno duguje" Binding="{Binding UkupnoDuguje, StringFormat=\{0:N2\}}" Width="125" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                        <DataGridTextColumn Header="Ukupno potražuje" Binding="{Binding UkupnoPotrazuje, StringFormat=\{0:N2\}}" Width="125" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                        <DataGridTextColumn Header="Saldo duguje" Binding="{Binding SaldoDuguje, StringFormat=\{0:N2\}}" Width="125" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                        <DataGridTextColumn Header="Saldo potražuje" Binding="{Binding SaldoPotrazuje, StringFormat=\{0:N2\}}" Width="125" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</Window>
