<UserControl x:Class="ERPiFinansijeApp.Views.Backup.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Rezervne kopije i restauracija (Backup &amp; Restore)" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                <TextBlock Text="Upravljanje automatskim i ručnim sigurnosnim kopijama knjigovodstvene baze podataka." FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="💾 Napravi ručni backup" Style="{StaticResource ActionButtonStyle}" Height="38" Padding="18,0" Click="BtnRucniBackup_Click" Margin="0,0,8,0"/>
                <Button Content="📥 Vrati iz fajla..." Height="38" Padding="14,0" Background="#F1F5F9" Foreground="#334155" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" Click="BtnVratiIzFajla_Click" Margin="0,0,8,0"/>
                <Button Content="🔄 Osveži" Height="38" Padding="14,0" Background="#F1F5F9" Foreground="#475569" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" Click="BtnOsvezi_Click"/>
            </StackPanel>
        </Grid>

        <!-- Settings Card for Auto-Backup -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="16,14" Margin="0,0,0,16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="⚙️ Učestanost automatskog pravljenja kopije pri radu" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <RadioButton x:Name="RbNikad" Content="Nikada" GroupName="AutoBackupGroup" Margin="0,0,20,0" Checked="AutoBackup_Changed"/>
                        <RadioButton x:Name="RbPriIzlasku" Content="Pri svakom izlasku iz programa" GroupName="AutoBackupGroup" Margin="0,0,20,0" Checked="AutoBackup_Changed"/>
                        <RadioButton x:Name="RbDnevno" Content="Jednom dnevno pri prvom izlasku" GroupName="AutoBackupGroup" Checked="AutoBackup_Changed"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtBackupFolder" Text="Folder: Baze/RezervneKopije" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- History DataGrid -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Padding="16,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                        <TextBlock Text="📜 Istorija i arhivirane rezervne kopije" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock x:Name="TxtUkupnoKopija" Text="Ukupno: 0 kopija" HorizontalAlignment="Right" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                    </Grid>
                </Border>

                <DataGrid x:Name="DgBackupHistory" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E2E8F0" HeadersVisibility="Column"
                          BorderThickness="0" Background="Transparent"
                          RowHeight="42" ColumnHeaderHeight="38">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Naziv arhivskog fajla" Binding="{Binding NazivFajla}" Width="2*"/>
                        <DataGridTextColumn Header="Datum i vreme kreiranja" Binding="{Binding DatumPrikaz}" Width="160"/>
                        <DataGridTextColumn Header="Veličina" Binding="{Binding VelicinaPrikaz}" Width="100"/>
                        <DataGridTextColumn Header="Tip kopije" Binding="{Binding Tip}" Width="160"/>
                        <DataGridTemplateColumn Header="Akcije" Width="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Button Content="🔄 Vrati" Height="28" Padding="10,0" Margin="0,0,4,0"
                                                Background="#2563EB" Foreground="White" BorderThickness="0" FontSize="11" FontWeight="SemiBold" Cursor="Hand"
                                                Click="BtnVratiKopiju_Click"/>
                                        <Button Content="🗑️ Izbriši" Height="28" Padding="10,0"
                                                Background="#FEF2F2" Foreground="#991B1B" BorderThickness="0" FontSize="11" FontWeight="SemiBold" Cursor="Hand"
                                                Click="BtnIzbrisiKopiju_Click"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
