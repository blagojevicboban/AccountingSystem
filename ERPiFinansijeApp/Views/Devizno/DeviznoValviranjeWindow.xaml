<Window x:Class="ERPiFinansijeApp.Views.Devizno.DeviznoValviranjeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="💱 Valviranje deviznih konta i Obračun Kursnih Razlika" Height="600" Width="950"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="💱 Valviranje Deviznih Konta i Kursne Razlike" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
            <TextBlock Text="Obračun i automatsko knjiženje pozitivnih (Konto 6630) i negativnih (Konto 5630) kursnih razlika na dan bilansa." FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Filter / Kursevi bar -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Na dan:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                <DatePicker Grid.Column="1" x:Name="DpNaDan" Width="130" Height="32" VerticalAlignment="Center" Margin="0,0,16,0"/>

                <TextBlock Grid.Column="2" Text="Kurs EUR (RSD):" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                <TextBox Grid.Column="3" x:Name="TxtKursEur" Width="90" Height="32" VerticalContentAlignment="Center" Padding="6,0" Text="117.2000" Margin="0,0,16,0"/>

                <TextBlock Grid.Column="4" Text="Kurs USD (RSD):" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                <TextBox Grid.Column="5" x:Name="TxtKursUsd" Width="90" Height="32" VerticalContentAlignment="Center" Padding="6,0" Text="108.5000" Margin="0,0,16,0"/>

                <Button Grid.Column="7" Content="🔄 Izračunaj kursne razlike" Style="{StaticResource ActionButtonStyle}" Background="#0284C7" Height="34" Padding="14,0" Click="BtnIzracunaj_Click"/>
            </Grid>
        </Border>

        <!-- DataGrid sa stavkama valviranja -->
        <DataGrid Grid.Row="2" x:Name="DgValviranje" AutoGenerateColumns="False" IsReadOnly="True" Background="{StaticResource SurfaceBrush}" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Broj konta" Binding="{Binding BrojKonta}" Width="100" FontWeight="Bold"/>
                <DataGridTextColumn Header="Valuta" Binding="{Binding Valuta}" Width="70"/>
                <DataGridTextColumn Header="Devizni saldo" Binding="{Binding DevizniSaldo, StringFormat={}{0:N2}}" Width="140" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                <DataGridTextColumn Header="Knjigovodstveni RSD" Binding="{Binding KnjigovodstveniSaldoRsd, StringFormat={}{0:N2}}" Width="160" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                <DataGridTextColumn Header="Tekući kurs" Binding="{Binding TekuciKurs, StringFormat={}{0:N4}}" Width="110"/>
                <DataGridTextColumn Header="Valvirani RSD" Binding="{Binding ValviraniSaldoRsd, StringFormat={}{0:N2}}" Width="160" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                <DataGridTextColumn Header="Kursna razlika RSD" Binding="{Binding KursnaRazlikaRsd, StringFormat={}{0:N2}}" Width="160" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Footer -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <TextBlock x:Name="TxtStatus" Text="Spremno za proračun kursnih razlika." VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="⚡ Proknjiži Valviranje (Nalog)" Style="{StaticResource ActionButtonStyle}" Background="#059669" Height="34" Padding="16,0" Margin="0,0,10,0" Click="BtnProknjizi_Click"/>
                <Button Content="Zatvori" Width="100" Height="34" Click="BtnZatvori_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
