<Window x:Class="ERPiFinansijeApp.Views.Nalozi.NalogEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:nalozi="clr-namespace:ERPiFinansijeApp.Views.Nalozi"
        Title="Nalog za knjiženje" Height="680" Width="950"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <nalozi:KontoPrikazConverter x:Key="KontoPrikazConverter"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Broj naloga: *" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                <TextBox x:Name="TxtBrojNaloga" Width="120" Height="32" VerticalContentAlignment="Center" Padding="6,0" Margin="0,0,24,0"/>

                <TextBlock Text="Datum: *" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                <DatePicker x:Name="DpDatum" Width="140" Height="32" VerticalContentAlignment="Center" Margin="0,0,24,0"/>

                <TextBlock Text="Opis naloga:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                <TextBox x:Name="TxtOpisNaloga" Width="300" Height="32" VerticalContentAlignment="Center" Padding="6,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="📋 Stavke naloga" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button x:Name="BtnDodajStavku" Content="➕ Dodaj stavku" Style="{StaticResource ActionButtonStyle}" Click="BtnDodajStavku_Click" Margin="0,0,8,0"/>
                    <Button x:Name="BtnPretragaKonta" Content="🔍 Pretraga konta (F2)" Style="{StaticResource ActionButtonStyle}" Background="#4F46E5" Click="BtnPretragaKonta_Click" Margin="0,0,8,0"/>
                    <Button x:Name="BtnSifarnikOpisa" Content="📝 Šifarnik opisa" Style="{StaticResource ActionButtonStyle}" Background="#8B5CF6" Click="BtnSifarnikOpisa_Click" Margin="0,0,8,0"/>
                    <Button x:Name="BtnObrisiStavku" Content="🗑 Obriši stavku" Style="{StaticResource ActionButtonStyle}" Background="#DC2626" Click="BtnObrisiStavku_Click" Margin="0,0,8,0"/>
                    <Button x:Name="BtnPriloziDms" Content="📎 Prilozi (DMS)" Style="{StaticResource ActionButtonStyle}" Background="#0284C7" Click="BtnPriloziDms_Click" Margin="0,0,8,0"/>
                    <Button x:Name="BtnPomoc" Content="❓ Pomoć (F1)" Style="{StaticResource ActionButtonStyle}" Background="#0D9488" Click="BtnPomoc_Click"/>
                </StackPanel>

                <DataGrid x:Name="DgStavke" AutoGenerateColumns="False" CanUserAddRows="False" GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column" Background="Transparent" BorderThickness="0"
                          CellEditEnding="DgStavke_CellEditEnding"
                          PreviewKeyDown="DgStavke_PreviewKeyDown">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="R.br." Binding="{Binding RedniBroj}" Width="50" IsReadOnly="True"/>
                        <!-- Template column instead of DataGridComboBoxColumn: the filtered
                             list is swapped as the user types, and a SelectedValueBinding
                             loses its value whenever the typed konto is not in the current
                             (filtered) ItemsSource. Konto is written to the model explicitly
                             in code-behind instead. -->
                        <DataGridTemplateColumn x:Name="ColKonto" Header="Konto (F2)" Width="240">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding BrojKonta, Converter={StaticResource KontoPrikazConverter}}"
                                               VerticalAlignment="Center" Margin="4,0" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox IsEditable="True"
                                              IsTextSearchEnabled="False"
                                              StaysOpenOnEdit="True"
                                              DisplayMemberPath="Prikaz"
                                              MaxDropDownHeight="280"
                                              VerticalContentAlignment="Center"
                                              Loaded="KontoCombo_Loaded"
                                              Unloaded="KontoCombo_Unloaded"
                                              SelectionChanged="KontoCombo_SelectionChanged"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Dokument" Binding="{Binding BrojDokumenta, UpdateSourceTrigger=PropertyChanged}" Width="130"/>
                        <DataGridTemplateColumn Header="Opis" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Opis}" VerticalAlignment="Center" Margin="4,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox IsEditable="True"
                                              Text="{Binding Opis, UpdateSourceTrigger=PropertyChanged}"
                                              ItemsSource="{Binding DataContext.OpisiPromenaOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                              VerticalContentAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Duguje (RSD)" Binding="{Binding Duguje, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" Width="110" ElementStyle="{StaticResource NumericColumnElementStyle}" EditingElementStyle="{StaticResource NumericColumnEditingStyle}"/>
                        <DataGridTextColumn Header="Potražuje (RSD)" Binding="{Binding Potrazuje, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" Width="110" ElementStyle="{StaticResource NumericColumnElementStyle}" EditingElementStyle="{StaticResource NumericColumnEditingStyle}"/>
                        <DataGridTextColumn Header="Valuta" Binding="{Binding Valuta, UpdateSourceTrigger=PropertyChanged}" Width="65"/>
                        <DataGridTextColumn Header="Kurs" Binding="{Binding KursValute, UpdateSourceTrigger=PropertyChanged, StringFormat=N4}" Width="80"/>
                        <DataGridTextColumn Header="Dev.Duguje" Binding="{Binding DevizniDuguje, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" Width="100" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                        <DataGridTextColumn Header="Dev.Potražuje" Binding="{Binding DevizniPotrazuje, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" Width="100" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                        <DataGridComboBoxColumn x:Name="ColPartner" Header="Partner"
                                                 SelectedValueBinding="{Binding PartnerId}"
                                                 SelectedValuePath="PartnerId"
                                                 DisplayMemberPath="Naziv"
                                                 Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Border x:Name="BorderBalans" Grid.Row="2" Margin="0,16,0,0" Padding="16,10" CornerRadius="8" Background="#ECFDF5">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="Duguje: " FontWeight="SemiBold"/>
                <TextBlock x:Name="TxtZbirDuguje" Text="0,00" Margin="0,0,24,0"/>
                <TextBlock Text="Potražuje: " FontWeight="SemiBold"/>
                <TextBlock x:Name="TxtZbirPotrazuje" Text="0,00" Margin="0,0,24,0"/>
                <TextBlock x:Name="TxtBalansStatus" Text="⚠️ Nema stavki" FontWeight="Bold"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="BtnOtkazi" Content="Otkaži (Esc)" IsCancel="True" Style="{StaticResource ActionButtonStyle}" Background="#64748B" Click="BtnOtkazi_Click" Margin="0,0,10,0"/>
            <Button x:Name="BtnSnimi" Content="💾 Snimi nalog" Style="{StaticResource ActionButtonStyle}" Background="#10B981" Click="BtnSnimi_Click"/>
        </StackPanel>
    </Grid>
</Window>
