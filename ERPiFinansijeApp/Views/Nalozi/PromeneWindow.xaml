<Window x:Class="ERPiFinansijeApp.Views.Nalozi.PromeneWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="📝 Šifarnik opisa promena" Height="520" Width="600"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}" KeyDown="Window_KeyDown">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="📝 Šifarnik opisa promena" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
            <TextBlock Text="Pregled i uređivanje standardnih opisa knjižnih promena za brži unos stavki." FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <DockPanel>
                <TextBox x:Name="TxtPretraga" DockPanel.Dock="Top" Height="34" Margin="0,0,0,12" Padding="8,0"
                         VerticalContentAlignment="Center" TextChanged="TxtPretraga_TextChanged"/>

                <DataGrid x:Name="DgPromene" AutoGenerateColumns="False" CanUserAddRows="False"
                          IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                          Background="Transparent" BorderThickness="0" SelectionChanged="DgPromene_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Šifra" Binding="{Binding Sifra}" Width="80"/>
                        <DataGridTextColumn Header="Opis promene" Binding="{Binding Opis}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="16" Margin="0,16,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Grid x:Name="GridForm">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="Šifra:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtSifra" Height="32" VerticalContentAlignment="Center" Padding="6,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Opis promene:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtOpis" Height="32" VerticalContentAlignment="Center" Padding="6,0"/>
                </StackPanel>

                <Button x:Name="BtnSacuvaj" Grid.Column="2" Content="💾 Sačuvaj" Style="{StaticResource ActionButtonStyle}"
                        Background="#10B981" VerticalAlignment="Bottom" Click="BtnSacuvaj_Click" Margin="0,0,8,0"/>

                <Button x:Name="BtnObrisi" Grid.Column="3" Content="🗑 Obriši" Style="{StaticResource ActionButtonStyle}"
                        Background="#DC2626" VerticalAlignment="Bottom" Click="BtnObrisi_Click"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Zatvori (Esc)" IsCancel="True" Width="110" Height="36" Style="{StaticResource ActionButtonStyle}"
                    Background="#64748B" Click="BtnZatvori_Click"/>
        </StackPanel>
    </Grid>
</Window>
