<Window x:Class="ERPiFinansijeApp.Views.Korisnici.KorisnikEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Korisnički nalog"
        SizeToContent="Height" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource BackgroundBrush}" KeyDown="Window_KeyDown">

    <Border Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,15">
                <TextBlock x:Name="TxtTitle" Text="👤 Dodavanje korisničkog naloga" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                <TextBlock Text="Podešavanje identifikacionih podataka, uloge i pristupa sistemu." FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Form -->
            <StackPanel Grid.Row="1">
                <!-- Korisničko ime i status -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Korisničko ime *" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtKorisnickoIme" Height="34" VerticalContentAlignment="Center" Padding="8,0" MaxLength="50"/>
                    </StackPanel>

                    <CheckBox x:Name="ChkIsActive" Grid.Column="2" Content="Nalog je aktivan" IsChecked="True" VerticalAlignment="Bottom" Margin="0,0,0,8" FontWeight="SemiBold"/>
                </Grid>

                <!-- Ime i prezime -->
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Ime i prezime *" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtImeIPrezime" Height="34" VerticalContentAlignment="Center" Padding="8,0" MaxLength="100"/>
                </StackPanel>

                <!-- Uloga -->
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Sistemska uloga *" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbUloga" Height="34" VerticalContentAlignment="Center" Padding="8,0">
                        <ComboBoxItem Content="Administrator"/>
                        <ComboBoxItem Content="Knjigovođa" IsSelected="True"/>
                        <ComboBoxItem Content="Gledalac"/>
                    </ComboBox>
                </StackPanel>

                <!-- Lozinka -->
                <StackPanel Margin="0,0,0,12">
                    <TextBlock x:Name="LblLozinka" Text="Lozinka *" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="TxtLozinka" Height="34" VerticalContentAlignment="Center" Padding="8,0"/>
                    <TextBlock x:Name="TxtLozinkaHint" Text="Ostavite prazno ako ne želite da menjate postojeću lozinku." FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </StackPanel>

            <!-- Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                <Button Content="Otkaži" Width="100" Height="36" Margin="0,0,10,0"
                        Background="#F1F5F9" Foreground="#475569" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand"
                        Click="BtnCancel_Click"/>
                <Button Content="Sačuvaj" Style="{StaticResource ActionButtonStyle}" Width="120"
                        Click="BtnSave_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
