<Window x:Class="ERPiFinansijeApp.Views.Konta.KontoPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🔍 Izbor konta iz kontnog plana" Height="500" Width="640"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{StaticResource BackgroundBrush}" KeyDown="Window_KeyDown">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="🔍 Izbor konta iz kontnog plana" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
            <TextBlock Text="Pretražite po broju konta ili nazivu. Koristite strelice i Enter ili dupli klik za izbor." FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="12,8" Margin="0,0,0,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="🔍 Pretraga:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                <TextBox x:Name="TxtPretraga" Grid.Column="1" Height="32" VerticalContentAlignment="Center" Padding="8,0" TextChanged="TxtPretraga_TextChanged" PreviewKeyDown="TxtPretraga_PreviewKeyDown"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <DataGrid x:Name="DgKonta" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="Transparent" BorderThickness="0" MouseDoubleClick="DgKonta_MouseDoubleClick" KeyDown="DgKonta_KeyDown">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Broj konta" Binding="{Binding BrojKonta}" Width="120" FontWeight="Bold"/>
                    <DataGridTextColumn Header="Naziv konta" Binding="{Binding NazivKonta}" Width="*"/>
                    <DataGridTextColumn Header="Stari konto" Binding="{Binding StariKonto}" Width="90"/>
                    <DataGridTextColumn Header="Tip" Binding="{Binding IsSintetika}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Otkaži (Esc)" Width="100" Height="36" Margin="0,0,10,0" Background="#E2E8F0" Foreground="#334155" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" Click="BtnOtkazi_Click"/>
            <Button Content="✅ Izaberi (Enter)" Width="140" Height="36" Style="{StaticResource ActionButtonStyle}" Background="#10B981" Click="BtnIzaberi_Click"/>
        </StackPanel>
    </Grid>
</Window>
