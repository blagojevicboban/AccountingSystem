{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build ERPiFinansijeApp",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/ERPiFinansijeApp/ERPiFinansijeApp.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "publish ERPiFinansijeApp (Self-Contained Single File)",
            "command": "dotnet",
            "type": "process",
            "args": [
                "publish",
                "${workspaceFolder}/ERPiFinansijeApp/ERPiFinansijeApp.csproj",
                "-c", "Release",
                "-r", "win-x64",
                "--self-contained", "true",
                "-p:PublishSingleFile=true",
                "-p:IncludeNativeLibrariesForSelfExtract=true",
                "-o", "${workspaceFolder}/publish_output"
            ],
            "problemMatcher": "$msCompile"
        }
    ]
}
